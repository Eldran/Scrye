<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- Avalonia 11.x. Bump to the latest 11.x when you first restore. -->
    <PackageReference Include="Avalonia" Version="11.0.0" />
    <PackageReference Include="Avalonia.Desktop" Version="11.0.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.0.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.0.0" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.0.0" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Scrye.Core\Scrye.Core.csproj" />
    <ProjectReference Include="..\Scrye.Scripting\Scrye.Scripting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bundled plugins: copied next to the exe so they auto-load on run. -->
    <Content Include="plugins\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
