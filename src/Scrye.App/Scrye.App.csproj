<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- Avalonia 12.x (latest stable). -->
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <!-- NOTE: Avalonia.Diagnostics was removed in Avalonia 12.
         The built-in F12 DevTools no longer exist; the replacement is the
         AvaloniaUI.DiagnosticsSupport package (Avalonia Plus Dev Tools). -->
    <!-- TTS: Windows-only at runtime (SpeechSynthesizer); guarded by OperatingSystem.IsWindows(). -->
    <PackageReference Include="System.Speech" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Scrye.Core\Scrye.Core.csproj" />
    <ProjectReference Include="..\Scrye.Scripting\Scrye.Scripting.csproj" />
    <!-- Mobile companion: the protocol contract and the in-process Kestrel/WebSocket host. -->
    <ProjectReference Include="..\Scrye.Companion.Protocol\Scrye.Companion.Protocol.csproj" />
    <ProjectReference Include="..\Scrye.Companion.Server\Scrye.Companion.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bundled plugins: copied next to the exe so they auto-load on run. -->
    <Content Include="plugins\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
