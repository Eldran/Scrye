<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Scrye.App.ViewModels"
        xmlns:controls="using:Scrye.App.Controls"
        xmlns:behaviors="using:Scrye.App.Behaviors"
        xmlns:conv="using:Avalonia.Data.Converters"
        x:Class="Scrye.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Scrye" Width="1040" Height="680"
        FontFamily="Segoe UI, sans-serif">

    <Grid>
        <DockPanel>
            <!-- quick-connect bar (full width) -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8" Spacing="6">
                <TextBox Width="220" Watermark="host" Text="{Binding Host}" />
                <TextBox Width="64" Watermark="port" Text="{Binding Port}" />
                <CheckBox Content="TLS" IsChecked="{Binding UseTls}" VerticalAlignment="Center" />
                <CheckBox Content="MIP" IsChecked="{Binding EnableMip}" VerticalAlignment="Center" />
                <Button Content="Quick Connect" Command="{Binding ConnectCommand}" />
                <Button Content="⚙ Settings" Command="{Binding OpenSettingsCommand}" HorizontalAlignment="Right" />
            </StackPanel>

            <!-- profile tree sidebar: MUD -> account -> character -->
            <Border DockPanel.Dock="Left" Width="230" Background="{DynamicResource ScryePanel}" Padding="8"
                    BorderBrush="{DynamicResource ScryeLine}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="MUDS" FontWeight="SemiBold" FontSize="11"
                               Foreground="{DynamicResource ScryeAccent}" Margin="2,0,0,8" />
                    <StackPanel DockPanel.Dock="Bottom" Spacing="4" Margin="0,6,0,0">
                        <Button Content="Connect" Command="{Binding ConnectNodeCommand}" HorizontalAlignment="Stretch" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button Content="New MUD" Command="{Binding NewMudCommand}" />
                            <Button Content="Edit" Command="{Binding EditNodeCommand}" />
                            <Button Content="Delete" Command="{Binding DeleteNodeCommand}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button Content="+ Account" Command="{Binding AddAccountCommand}"
                                    ToolTip.Tip="Add an account under the selected MUD — its settings are shared by every character in it" />
                            <Button Content="+ Character" Command="{Binding AddCharacterCommand}"
                                    ToolTip.Tip="Add a character under the selected MUD or account" />
                        </StackPanel>
                    </StackPanel>
                    <TreeView ItemsSource="{Binding Muds}" SelectedItem="{Binding SelectedNode}"
                              Background="Transparent">
                        <TreeView.Styles>
                            <Style Selector="TreeViewItem">
                                <Setter Property="IsExpanded" Value="True" />
                            </Style>
                        </TreeView.Styles>
                        <TreeView.ItemTemplate>
                            <TreeDataTemplate x:DataType="vm:ProfileNodeViewModel" ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{Binding Glyph}" FontSize="11" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                </StackPanel>
                            </TreeDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>
            </Border>

            <!-- connected worlds -->
            <TabControl ItemsSource="{Binding Worlds}" SelectedItem="{Binding Active}" Padding="0">
                <TabControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:WorldViewModel">
                        <TextBlock Text="{Binding Title}" />
                    </DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ContentTemplate>
                    <DataTemplate x:DataType="vm:WorldViewModel">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="{Binding DebuggerColWidth}" />
                            </Grid.ColumnDefinitions>
                            <!-- main column: output + input row, with the plugin HUD overlaid top-right -->
                            <Grid Grid.Column="0">
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Bottom" Margin="4">
                                        <ToggleButton DockPanel.Dock="Right" Content="Debugger"
                                                      IsChecked="{Binding ShowDebugger}" Margin="4,0,0,0" />
                                        <ToggleButton DockPanel.Dock="Right" Content="Plugins"
                                                      IsChecked="{Binding Plugins.IsOpen}" Margin="4,0,0,0" />
                                        <ToggleButton DockPanel.Dock="Right" Content="State"
                                                      IsChecked="{Binding StateInspector.IsOpen}" Margin="4,0,0,0"
                                                      ToolTip.Tip="Game-state inspector: live GMCP/MIP data as watchable paths" />
                                        <TextBox Text="{Binding Input}" Watermark="type a command and press Enter…"
                                                 KeyDown="OnInputKeyDown" />
                                    </DockPanel>

                                    <!-- running-sequence status strip (visible while a sequence runs) -->
                                    <Border DockPanel.Dock="Bottom" IsVisible="{Binding Sequence.IsActive}"
                                            Margin="4,0,4,0" Padding="8,4" Background="{DynamicResource ScryePanelAlt}"
                                            BorderBrush="{DynamicResource ScryeLine}" BorderThickness="1" CornerRadius="5">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Stop" Command="{Binding Sequence.StopCommand}" Margin="4,0,0,0" Padding="10,2" />
                                            <Button DockPanel.Dock="Right" Content="Resume" Command="{Binding Sequence.ResumeCommand}" Margin="4,0,0,0" Padding="10,2" />
                                            <Button DockPanel.Dock="Right" Content="Pause" Command="{Binding Sequence.PauseCommand}" Margin="4,0,0,0" Padding="10,2" />
                                            <TextBlock Text="{Binding Sequence.StatusText}" VerticalAlignment="Center" Foreground="{DynamicResource ScryeText}" />
                                        </DockPanel>
                                    </Border>

                                    <!-- find-in-scrollback bar (Ctrl+F) -->
                                    <Border DockPanel.Dock="Top" IsVisible="{Binding Find.IsOpen}"
                                            Margin="4,4,4,0" Padding="6,3" Background="{DynamicResource ScryePanelAlt}"
                                            BorderBrush="{DynamicResource ScryeLine}" BorderThickness="1" CornerRadius="5">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="✕" Command="{Binding Find.CloseCommand}"
                                                    Padding="8,2" Margin="4,0,0,0" />
                                            <Button DockPanel.Dock="Right" Content="▼" Command="{Binding Find.NextCommand}"
                                                    Padding="8,2" Margin="4,0,0,0" />
                                            <Button DockPanel.Dock="Right" Content="▲" Command="{Binding Find.PrevCommand}"
                                                    Padding="8,2" Margin="4,0,0,0" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Find.Status}" VerticalAlignment="Center"
                                                       Margin="8,0" Foreground="{DynamicResource ScryeTextDim}" />
                                            <ToggleButton DockPanel.Dock="Right" Content="Aa" IsChecked="{Binding Find.MatchCase}"
                                                          Padding="8,2" Margin="4,0,0,0" ToolTip.Tip="Match case" />
                                            <TextBox Name="FindBox" Text="{Binding Find.Query}" Watermark="find in output…"
                                                     KeyDown="OnFindKeyDown" />
                                        </DockPanel>
                                    </Border>

                                    <controls:TerminalPane Margin="4" Background="{DynamicResource ScryeOutputBg}"
                                                           Source="{Binding Scrollback}"
                                                           FontFamily="{Binding OutputFontFamily}"
                                                           FontSize="{Binding OutputFontSize}"
                                                           SearchTerm="{Binding Find.Term}"
                                                           ActiveMatchLine="{Binding Find.ActiveLine}"
                                                           MatchCase="{Binding Find.MatchCase}"
                                                           CommandLinkClicked="OnCommandLinkClicked" />
                                </DockPanel>

                                <!-- HUD overlay: plugin panels, top-right, over the output -->
                                <ItemsControl ItemsSource="{Binding Hud.Panels}"
                                              HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,20,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:HudPanelViewModel">
                                            <Border Background="{DynamicResource ScryePanelGlass}" BorderBrush="{DynamicResource ScryeLine}"
                                                    BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8"
                                                    Width="{Binding Width}" HorizontalAlignment="Right">
                                                <!-- widget templates live on the Border so both the flat list and tab contents share them -->
                                                <Border.DataTemplates>
                                                    <DataTemplate DataType="vm:LabelWidgetViewModel">
                                                        <TextBlock Text="{Binding Text}" FontSize="11" Foreground="{DynamicResource ScryeText}" />
                                                    </DataTemplate>
                                                    <DataTemplate DataType="vm:ProgressWidgetViewModel">
                                                        <StackPanel Spacing="1" Margin="0,1">
                                                            <TextBlock Text="{Binding Label}" FontSize="10" Foreground="{DynamicResource ScryeTextDim}" />
                                                            <Grid>
                                                                <ProgressBar Minimum="0" Maximum="{Binding Maximum}"
                                                                             Value="{Binding Value}" Height="15" />
                                                                <TextBlock Text="{Binding Caption}" FontSize="10" Foreground="#FFFFFF"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Grid>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                    <DataTemplate DataType="vm:GaugeWidgetViewModel">
                                                        <DockPanel Margin="0,1">
                                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Label}" FontSize="10" Width="52"
                                                                       Foreground="{DynamicResource ScryeTextDim}" VerticalAlignment="Center" />
                                                            <Grid>
                                                                <ProgressBar Minimum="0" Maximum="{Binding Maximum}" Value="{Binding Value}"
                                                                             Height="14" Foreground="{Binding BarBrush}" />
                                                                <TextBlock Text="{Binding Caption}" FontSize="9.5" Foreground="#FFFFFF"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Grid>
                                                        </DockPanel>
                                                    </DataTemplate>
                                                    <DataTemplate DataType="vm:TextWidgetViewModel">
                                                        <TextBlock Text="{Binding Text}" FontSize="10.5" Foreground="{Binding Foreground}"
                                                                   FontFamily="Cascadia Mono, Consolas, monospace" TextWrapping="NoWrap" Margin="0,2" />
                                                    </DataTemplate>
                                                    <DataTemplate DataType="vm:ColorGridWidgetViewModel">
                                                        <controls:ColorGridView GridText="{Binding GridText}" Palette="{Binding Palette}" Margin="0,3" />
                                                    </DataTemplate>
                                                    <DataTemplate DataType="vm:ButtonWidgetViewModel">
                                                        <Button Content="{Binding Text}" Command="{Binding Command}"
                                                                HorizontalAlignment="Stretch" Margin="0,1" Padding="8,3" FontSize="11" />
                                                    </DataTemplate>
                                                </Border.DataTemplates>
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="11"
                                                               Foreground="{DynamicResource ScryeAccent}" />
                                                    <ItemsControl ItemsSource="{Binding Widgets}" IsVisible="{Binding !HasTabs}" />
                                                    <TabControl ItemsSource="{Binding Tabs}" IsVisible="{Binding HasTabs}" Padding="0,4,0,0">
                                                        <TabControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:HudTabViewModel">
                                                                <TextBlock Text="{Binding Title}" FontSize="11" />
                                                            </DataTemplate>
                                                        </TabControl.ItemTemplate>
                                                        <TabControl.ContentTemplate>
                                                            <DataTemplate x:DataType="vm:HudTabViewModel">
                                                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="460">
                                                                    <ItemsControl ItemsSource="{Binding Widgets}" Margin="0,2,0,0" />
                                                                </ScrollViewer>
                                                            </DataTemplate>
                                                        </TabControl.ContentTemplate>
                                                    </TabControl>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- plugins manager: list / reload / enable-disable (Ctrl-free; toggle button) -->
                                <Border IsVisible="{Binding Plugins.IsOpen}" HorizontalAlignment="Left" VerticalAlignment="Top"
                                        Width="300" MaxHeight="380" Margin="12,10,0,0" Padding="10"
                                        Background="{DynamicResource ScryePanelGlass}" BorderBrush="{DynamicResource ScryeLine}"
                                        BorderThickness="1" CornerRadius="6">
                                    <DockPanel>
                                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                            <Button DockPanel.Dock="Right" Content="✕" Command="{Binding Plugins.CloseCommand}" Padding="6,1" />
                                            <Button DockPanel.Dock="Right" Content="↻" Command="{Binding Plugins.RescanCommand}" Padding="6,1" Margin="0,0,4,0"
                                                    ToolTip.Tip="Rescan folders + install any .scryeplugin packages dropped in" />
                                            <TextBlock Text="PLUGINS" FontWeight="SemiBold" FontSize="11"
                                                       Foreground="{DynamicResource ScryeAccent}" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="4" Margin="0,6,0,0">
                                            <Button Content="New plugin" Command="{Binding Plugins.NewCommand}" Padding="8,2" FontSize="10" />
                                            <Button Content="Open folder" Command="{Binding Plugins.OpenFolderCommand}" Padding="8,2" FontSize="10" />
                                        </StackPanel>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding Plugins.Plugins}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:PluginRowViewModel">
                                                        <Border Margin="0,0,0,4" Padding="6" CornerRadius="4"
                                                                Background="{DynamicResource ScryePanelAlt}">
                                                            <DockPanel>
                                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4">
                                                                    <Button Content="Reload" Command="{Binding ReloadCommand}" Padding="6,1" FontSize="10" />
                                                                    <Button Content="{Binding ToggleLabel}" Command="{Binding ToggleCommand}" Padding="6,1" FontSize="10" />
                                                                    <Button Content="Remove" Command="{Binding RemoveCommand}" IsVisible="{Binding Removable}"
                                                                            Padding="6,1" FontSize="10" />
                                                                </StackPanel>
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource ScryeText}" FontSize="11" />
                                                                    <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource ScryeTextDim}" FontSize="10" />
                                                                </StackPanel>
                                                            </DockPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </DockPanel>
                                </Border>

                                <!-- game-state inspector overlay (idea #9): live GMCP/MIP paths -->
                                <Border IsVisible="{Binding StateInspector.IsOpen}" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                        Width="380" Margin="12,10,0,44" Padding="10"
                                        Background="{DynamicResource ScryePanelGlass}" BorderBrush="{DynamicResource ScryeLine}"
                                        BorderThickness="1" CornerRadius="6">
                                    <DockPanel>
                                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                            <Button DockPanel.Dock="Right" Content="✕" Command="{Binding StateInspector.CloseCommand}" Padding="6,1" />
                                            <TextBlock Text="GAME STATE" FontWeight="SemiBold" FontSize="11"
                                                       Foreground="{DynamicResource ScryeAccent}" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <TextBox DockPanel.Dock="Top" Text="{Binding StateInspector.Filter}" Watermark="filter paths and values…"
                                                 FontSize="11" Margin="0,0,0,6" />
                                        <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0" Spacing="2">
                                            <SelectableTextBlock Text="{Binding StateInspector.Detail}" FontFamily="Cascadia Mono, Consolas, monospace"
                                                                 FontSize="11" Foreground="{DynamicResource ScryeText}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding StateInspector.Status}" FontSize="10"
                                                       Foreground="{DynamicResource ScryeTextDim}" />
                                        </StackPanel>
                                        <ListBox ItemsSource="{Binding StateInspector.Rows}" SelectedItem="{Binding StateInspector.SelectedRow}"
                                                 Background="Transparent" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="11">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:StateRowViewModel">
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" Foreground="{DynamicResource ScryeText}"
                                                                   Margin="8,0,0,0" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Path}" Foreground="{DynamicResource ScryeTextDim}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </DockPanel>
                                </Border>
                            </Grid>

                            <!-- drag handle to resize the debugger panel -->
                            <GridSplitter Grid.Column="1" Width="5" ResizeDirection="Columns"
                                          Background="{DynamicResource ScryeLine}" IsVisible="{Binding ShowDebugger}" />

                            <!-- debugger (toggle-able, resizable): Live timeline + Replay transport -->
                            <Border Grid.Column="2" MinWidth="280" IsVisible="{Binding ShowDebugger}"
                                    Background="{DynamicResource ScryePanel}" BorderBrush="{DynamicResource ScryeLine}"
                                    BorderThickness="1,0,0,0" Padding="6">
                                <TabControl>
                                    <!-- LIVE: the running event timeline -->
                                    <TabItem Header="Live">
                                        <DockPanel>
                                            <!-- category filters -->
                                            <WrapPanel DockPanel.Dock="Top" Margin="0,4,0,4">
                                                <CheckBox Content="Output" IsChecked="{Binding Debugger.ShowOutput}" Margin="0,0,6,0" />
                                                <CheckBox Content="Input" IsChecked="{Binding Debugger.ShowInput}" Margin="0,0,6,0" />
                                                <CheckBox Content="Auto" IsChecked="{Binding Debugger.ShowAutomation}" Margin="0,0,6,0" />
                                                <CheckBox Content="State" IsChecked="{Binding Debugger.ShowState}" Margin="0,0,6,0" />
                                                <CheckBox Content="Proto" IsChecked="{Binding Debugger.ShowProtocol}" Margin="0,0,6,0" />
                                                <CheckBox Content="Sys" IsChecked="{Binding Debugger.ShowSystem}" Margin="0,0,6,0" />
                                            </WrapPanel>

                                            <!-- transport controls -->
                                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,4">
                                                <ToggleButton Content="Pause" IsChecked="{Binding Debugger.Paused}" />
                                                <Button Content="{Binding Debugger.RecordLabel}" Command="{Binding Debugger.RecordCommand}" />
                                                <Button Content="Clear" Command="{Binding Debugger.ClearCommand}" />
                                            </StackPanel>

                                            <!-- simulate a line against the triggers (dry-run) -->
                                            <DockPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
                                                <Button DockPanel.Dock="Right" Content="Simulate"
                                                        Command="{Binding Debugger.SimulateCommand}" Margin="4,0,0,0" />
                                                <TextBox Text="{Binding Debugger.SimulateInput}"
                                                         Watermark="test a line against triggers…" />
                                            </DockPanel>

                                            <!-- drill-down: full text of the selected row (fixes truncation) -->
                                            <Border DockPanel.Dock="Bottom" Margin="0,4,0,0" Padding="6"
                                                    Background="{DynamicResource ScryeOutputBg}" BorderBrush="{DynamicResource ScryeLine}" BorderThickness="1"
                                                    IsVisible="{Binding Debugger.SelectedRow, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                                                <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
                                                    <SelectableTextBlock Text="{Binding Debugger.SelectedRow.Full}" TextWrapping="Wrap"
                                                                         FontFamily="Cascadia Mono, Consolas, monospace" FontSize="11" Foreground="{DynamicResource ScryeText}" />
                                                </ScrollViewer>
                                            </Border>

                                            <!-- the event stream -->
                                            <ListBox ItemsSource="{Binding Debugger.Rows}" SelectedItem="{Binding Debugger.SelectedRow}"
                                                     behaviors:AutoScroll.Enabled="True"
                                                     Background="{DynamicResource ScryeOutputBg}" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="11">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:EventRowViewModel">
                                                        <TextBlock Text="{Binding Display}" Foreground="{Binding Brush}" />
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </DockPanel>
                                    </TabItem>

                                    <!-- REPLAY: load a recording, step through it, re-run vs current triggers -->
                                    <TabItem Header="Replay">
                                        <DockPanel>
                                            <!-- recording picker -->
                                            <DockPanel DockPanel.Dock="Top" Margin="0,4,0,4">
                                                <Button DockPanel.Dock="Right" Content="Load"
                                                        Command="{Binding Replay.LoadCommand}" Margin="4,0,0,0" />
                                                <Button DockPanel.Dock="Right" Content="↻"
                                                        Command="{Binding Replay.RefreshCommand}" Margin="4,0,0,0" />
                                                <ComboBox ItemsSource="{Binding Replay.Recordings}"
                                                          SelectedItem="{Binding Replay.SelectedRecording}"
                                                          HorizontalAlignment="Stretch" />
                                            </DockPanel>

                                            <!-- transport -->
                                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,4">
                                                <Button Content="{Binding Replay.PlayLabel}" Command="{Binding Replay.PlayPauseCommand}" />
                                                <Button Content="Step" Command="{Binding Replay.StepCommand}" />
                                                <Button Content="Restart" Command="{Binding Replay.RestartCommand}" />
                                                <ComboBox ItemsSource="{Binding Replay.SpeedOptions}" SelectedItem="{Binding Replay.Speed}"
                                                          Width="64" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Replay.PositionLabel}" VerticalAlignment="Center" Foreground="{DynamicResource ScryeTextDim}" />
                                            </StackPanel>

                                            <!-- scrub the timeline -->
                                            <Slider DockPanel.Dock="Top" Minimum="0" Maximum="{Binding Replay.Total}"
                                                    Value="{Binding Replay.Position, Mode=TwoWay}" Margin="0,0,0,4" />

                                            <TextBlock DockPanel.Dock="Top" Text="{Binding Replay.Status}"
                                                       TextWrapping="Wrap" Foreground="{DynamicResource ScryeTextDim}" Margin="0,0,0,4" />

                                            <!-- the killer feature -->
                                            <Button DockPanel.Dock="Bottom" Margin="0,4,0,0" HorizontalAlignment="Stretch"
                                                    Content="Re-run vs current triggers" Command="{Binding Replay.AnalyzeCommand}" />

                                            <!-- diff results from the re-run -->
                                            <Border DockPanel.Dock="Bottom" IsVisible="{Binding Replay.HasDiffs}" Margin="0,4,0,0" Padding="6"
                                                    Background="{DynamicResource ScryeOutputBg}" BorderBrush="{DynamicResource ScryeLine}" BorderThickness="1">
                                                <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto">
                                                    <ItemsControl ItemsSource="{Binding Replay.DiffLines}" x:CompileBindings="False">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="#E0B0FF"
                                                                           FontFamily="Cascadia Mono, Consolas, monospace" FontSize="11" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </Border>

                                            <!-- drill-down: full text of the selected recorded row -->
                                            <Border DockPanel.Dock="Bottom" Margin="0,4,0,0" Padding="6"
                                                    Background="{DynamicResource ScryeOutputBg}" BorderBrush="{DynamicResource ScryeLine}" BorderThickness="1"
                                                    IsVisible="{Binding Replay.SelectedRow, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                                                <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
                                                    <SelectableTextBlock Text="{Binding Replay.SelectedRow.Full}" TextWrapping="Wrap"
                                                                         FontFamily="Cascadia Mono, Consolas, monospace" FontSize="11" Foreground="{DynamicResource ScryeText}" />
                                                </ScrollViewer>
                                            </Border>

                                            <!-- recorded events, revealed up to the current position -->
                                            <ListBox ItemsSource="{Binding Replay.Rows}" SelectedItem="{Binding Replay.SelectedRow}"
                                                     behaviors:AutoScroll.Enabled="True"
                                                     Background="{DynamicResource ScryeOutputBg}" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="11">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:EventRowViewModel">
                                                        <TextBlock Text="{Binding Display}" Foreground="{Binding Brush}" />
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </DockPanel>
                                    </TabItem>
                                </TabControl>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>
        </DockPanel>

        <!-- settings form overlay -->
        <Border IsVisible="{Binding Editor, Converter={x:Static conv:ObjectConverters.IsNotNull}}"
                Background="#B0000000">
            <Border Width="700" MaxHeight="640" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource ScryePanel}" BorderBrush="{DynamicResource ScryeLine}"
                    BorderThickness="1" CornerRadius="8" Padding="18">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding Editor.Title}" FontWeight="SemiBold" FontSize="16"
                               Foreground="{DynamicResource ScryeAccent}" Margin="0,0,0,2" />
                    <TextBlock DockPanel.Dock="Top" Text="{Binding Editor.Subtitle}" FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource ScryeTextDim}" Margin="0,0,0,8" />

                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8"
                                HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="Cancel" Command="{Binding CancelEditorCommand}" />
                        <Button Content="Save" Command="{Binding SaveEditorCommand}" />
                    </StackPanel>

                    <TabControl>
                        <!-- CONNECTION -->
                        <TabItem Header="Connection">
                            <StackPanel Spacing="6" Margin="0,8,0,0">
                                <TextBlock Text="Name" />
                                <TextBox Text="{Binding Editor.Name}" />
                                <TextBlock Text="Host" />
                                <TextBox Text="{Binding Editor.Host}" />
                                <TextBlock Text="Port" />
                                <TextBox Text="{Binding Editor.Port}" />
                                <TextBlock Text="Username (auto-login, optional)" />
                                <TextBox Text="{Binding Editor.Username}" />
                                <TextBlock Text="Password (auto-login, optional)" />
                                <TextBox Text="{Binding Editor.Password}" PasswordChar="●"
                                         Watermark="{Binding Editor.PasswordHint}" />
                                <TextBlock Text="Encoding" />
                                <TextBox Text="{Binding Editor.Encoding}" />
                                <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
                                    <CheckBox Content="TLS" IsChecked="{Binding Editor.UseTls}" />
                                    <CheckBox Content="MIP (3Scapes)" IsChecked="{Binding Editor.EnableMip}" />
                                    <CheckBox Content="MXP" IsChecked="{Binding Editor.EnableMxp}"
                                              ToolTip.Tip="Clickable links + inline markup when the server supports it" />
                                </StackPanel>
                            </StackPanel>
                        </TabItem>

                        <!-- TRIGGERS -->
                        <TabItem Header="Triggers">
                            <Grid ColumnDefinitions="220,*" Margin="0,8,0,0">
                                <DockPanel Grid.Column="0" Margin="0,0,10,0">
                                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                                        <Button Content="Add" Command="{Binding Editor.AddTriggerCommand}" />
                                        <Button Content="Remove" Command="{Binding Editor.RemoveTriggerCommand}" />
                                    </StackPanel>
                                    <ListBox ItemsSource="{Binding Editor.Triggers}" SelectedItem="{Binding Editor.SelectedTrigger}"
                                             Height="420" Background="{DynamicResource ScryeOutputBg}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:TriggerRowViewModel">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource ScryeText}" />
                                                    <TextBlock Text="{Binding Pattern}" FontSize="10" Foreground="{DynamicResource ScryeTextDim}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                                <Border Grid.Column="1" DataContext="{Binding Editor.SelectedTrigger}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel Spacing="4" x:DataType="vm:TriggerRowViewModel" IsVisible="{Binding Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                                            <TextBlock Text="Name" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                            <TextBox Text="{Binding Name}" />
                                            <TextBlock Text="Pattern (line to match)" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                            <TextBox Text="{Binding Pattern}" />
                                            <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,2">
                                                <CheckBox Content="Regex" IsChecked="{Binding IsRegex}" />
                                                <CheckBox Content="Ignore case" IsChecked="{Binding IgnoreCase}" />
                                                <CheckBox Content="Enabled" IsChecked="{Binding Enabled}" />
                                            </StackPanel>
                                            <TextBlock Text="Send to" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                            <ComboBox ItemsSource="{x:Static vm:RuleRowViewModel.SendToValues}" SelectedItem="{Binding SendTo}"
                                                      HorizontalAlignment="Left" Width="180" />
                                            <TextBlock Text="Send (text / %1 %&lt;name&gt; ${var} template)" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                            <TextBox Text="{Binding Send}" />
                                            <Grid ColumnDefinitions="*,*" Margin="0,2,0,0">
                                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                    <TextBlock Text="Variable (for Variable)" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                                    <TextBox Text="{Binding Variable}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                    <TextBlock Text="Script fn (for Script)" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                                    <TextBox Text="{Binding Script}" />
                                                </StackPanel>
                                            </Grid>
                                            <Grid ColumnDefinitions="*,*" Margin="0,2,0,0">
                                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                    <TextBlock Text="Group" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                                    <TextBox Text="{Binding Group}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                    <TextBlock Text="Sequence (lower first)" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                                    <TextBox Text="{Binding SequenceText}" />
                                                </StackPanel>
                                            </Grid>
                                            <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,2">
                                                <CheckBox Content="Keep evaluating" IsChecked="{Binding KeepEvaluating}" />
                                                <CheckBox Content="One-shot" IsChecked="{Binding OneShot}" />
                                            </StackPanel>
                                            <Border Background="{DynamicResource ScryeOutputBg}" BorderBrush="{DynamicResource ScryeLine}"
                                                    BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,6,0,0">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="Test pattern" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                                    <DockPanel>
                                                        <Button DockPanel.Dock="Right" Content="Test" Command="{Binding TestCommand}" Margin="4,0,0,0" />
                                                        <TextBox Text="{Binding TestInput}" Watermark="sample line to match…" />
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding TestResult}" Foreground="{DynamicResource ScryeText}" FontSize="11" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </TabItem>

                        <!-- ALIASES -->
                        <TabItem Header="Aliases">
                            <Grid ColumnDefinitions="220,*" Margin="0,8,0,0">
                                <DockPanel Grid.Column="0" Margin="0,0,10,0">
                                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
