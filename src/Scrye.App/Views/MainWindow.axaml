<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Scrye.App.ViewModels"
        xmlns:controls="using:Scrye.App.Controls"
        xmlns:behaviors="using:Scrye.App.Behaviors"
        xmlns:conv="using:Avalonia.Data.Converters"
        x:Class="Scrye.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Scrye" Width="1040" Height="680"
        FontFamily="Segoe UI, sans-serif">

    <Grid>
        <DockPanel>
            <!-- profile tree sidebar: MUD -> account -> character -->
            <Border DockPanel.Dock="Left" Width="230" Background="{DynamicResource ScryePanel}" Padding="8"
                    BorderBrush="{DynamicResource ScryeLine}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="MUDS" FontWeight="SemiBold" FontSize="11"
                               Foreground="{DynamicResource ScryeAccent}" Margin="2,0,0,8" />
                    <StackPanel DockPanel.Dock="Bottom" Spacing="4" Margin="0,6,0,0">
                        <!-- also in each world's bottom bar; this copy makes Settings reachable
                             BEFORE any world is connected -->
                        <Button Content="⚙ Settings" Command="{Binding OpenSettingsCommand}" HorizontalAlignment="Stretch" />
                        <Button Content="Quick Connect" Command="{Binding OpenQuickConnectCommand}" HorizontalAlignment="Stretch"
                                ToolTip.Tip="Connect to a host/port without saving a profile (session-only)" />
                        <Button Content="Connect" Command="{Binding ConnectNodeCommand}" HorizontalAlignment="Stretch" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button Content="New MUD" Command="{Binding NewMudCommand}" />
                            <Button Content="Edit" Command="{Binding EditNodeCommand}" />
                            <Button Content="Delete" Command="{Binding DeleteNodeCommand}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button Content="+ Account" Command="{Binding AddAccountCommand}"
                                    ToolTip.Tip="Add an account under the selected MUD — its settings are shared by every character in it" />
                            <Button Content="+ Character" Command="{Binding AddCharacterCommand}"
                                    ToolTip.Tip="Add a character under the selected MUD or account" />
                        </StackPanel>
                    </StackPanel>
                    <TreeView ItemsSource="{Binding Muds}" SelectedItem="{Binding SelectedNode}"
                              Background="Transparent">
                        <TreeView.Styles>
                            <Style Selector="TreeViewItem">
                                <Setter Property="IsExpanded" Value="True" />
                            </Style>
                        </TreeView.Styles>
                        <TreeView.ItemTemplate>
                            <TreeDataTemplate x:DataType="vm:ProfileNodeViewModel" ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{Binding Glyph}" FontSize="11" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                </StackPanel>
                            </TreeDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>
            </Border>

            <!-- connected worlds -->
            <TabControl ItemsSource="{Binding Worlds}" SelectedItem="{Binding Active}" Padding="0">
                <TabControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:WorldViewModel">
                        <StackPanel Orientation="Horizontal" Spacing="6" ToolTip.Tip="{Binding StatusTip}">
                            <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                            <Border Background="{DynamicResource ScryeBadgeBg}" CornerRadius="8" Padding="6,0"
                                    IsVisible="{Binding HasUnread}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding UnreadText}" FontSize="11" Foreground="White" />
                            </Border>
                            <Button Content="✕" FontSize="11" Padding="4,0" Margin="2,0,0,0"
                                    Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                                    ToolTip.Tip="Close this world"
                                    Command="{Binding $parent[TabControl].((vm:MainWindowViewModel)DataContext).CloseWorldCommand}"
                                    CommandParameter="{Binding}" />
                        </StackPanel>
                    </DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ContentTemplate>
                    <DataTemplate x:DataType="vm:WorldViewModel">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="{Binding DebuggerColWidth}" />
                            </Grid.ColumnDefinitions>
                            <!-- main column: output + input row, with the plugin HUD overlaid top-right -->
                            <Grid Grid.Column="0">
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Bottom" Margin="4">
                                        <ToggleButton DockPanel.Dock="Right" Content="Debugger"
                                                      IsChecked="{Binding ShowDebugger}" Margin="4,0,0,0" />
                                        <ToggleButton DockPanel.Dock="Right" Content="Panes"
                                                      IsChecked="{Binding ShowPanes}" Margin="4,0,0,0"
                                                      ToolTip.Tip="Capture panes: output routed by triggers (capture to pane)" />
                                        <ToggleButton DockPanel.Dock="Right" Content="Plugins"
                                                      IsChecked="{Binding Plugins.IsOpen}" Margin="4,0,0,0" />
                                        <ToggleButton DockPanel.Dock="Right" Content="📱 Companion"
                                                      IsChecked="{Binding CompanionPanel.IsOpen}" Margin="4,0,0,0"
                                                      ToolTip.Tip="Mobile companion: serve this session to your phone, and see what can notify you" />
                                        <ToggleButton DockPanel.Dock="Right" Content="State"
                                                      IsChecked="{Binding StateInspector.IsOpen}" Margin="4,0,0,0"
                                                      ToolTip.Tip="Game-state inspector: live GMCP/MIP data as watchable paths" />
                                        <ToggleButton DockPanel.Dock="Right" Content="⇉ All"
                                                      IsChecked="{Binding IsBroadcast}" Margin="4,0,0,0"
                                                      ToolTip.Tip="Broadcast: send typed commands to every connected world (. and / commands stay local). One-off: .all &lt;command&gt;" />
                                        <ToggleButton DockPanel.Dock="Right" Content="🔊 TTS"
                                                      IsChecked="{Binding TtsEnabled}" Margin="4,0,0,0"
                                                      AutomationProperties.Name="Text to speech"
                                                      ToolTip.Tip="Speak incoming lines aloud (Windows). Commands: .tts on/off/stop/rate N" />
                                        <TextBox Text="{Binding Input}" PlaceholderText="type a command and press Enter…"
                                                 Classes="terminalinput"
                                                 AutomationProperties.Name="Command input"
                                                 KeyDown="OnInputKeyDown" />
                                    </DockPanel>

                                    <!-- running-sequence status strip (visible while a sequence runs) -->
                                    <Border DockPanel.Dock="Bottom" IsVisible="{Binding Sequence.IsActive}"
                                            Margin="4,0,4,0" Padding="8,4" Background="{DynamicResource ScryePanelAlt}"
                                            BorderBrush="{DynamicResource ScryeLine}" BorderThickness="1" CornerRadius="5">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Stop" Command="{Binding Sequence.StopCommand}" Margin="4,0,0,0" Padding="10,2" />
                                            <Button DockPanel.Dock="Right" Content="Resume" Command="{Binding Sequence.ResumeCommand}" Margin="4,0,0,0" Padding="10,2" />
                                            <Button DockPanel.Dock="Right" Content="Pause" Command="{Binding Sequence.PauseCommand}" Margin="4,0,0,0" Padding="10,2" />
                                            <TextBlock Text="{Binding Sequence.StatusText}" VerticalAlignment="Center" Foreground="{DynamicResource ScryeText}" />
                                        </DockPanel>
                                    </Border>

                                    <!-- find-in-scrollback bar (Ctrl+F) -->
                                    <Border DockPanel.Dock="Top" IsVisible="{Binding Find.IsOpen}"
                                            Margin="4,4,4,0" Padding="6,3" Background="{DynamicResource ScryePanelAlt}"
                                            BorderBrush="{DynamicResource ScryeLine}" BorderThickness="1" CornerRadius="5">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="✕" Command="{Binding Find.CloseCommand}"
                                                    Padding="8,2" Margin="4,0,0,0" />
                                            <Button DockPanel.Dock="Right" Content="▼" Command="{Binding Find.NextCommand}"
                                                    Padding="8,2" Margin="4,0,0,0" />
                                            <Button DockPanel.Dock="Right" Content="▲" Command="{Binding Find.PrevCommand}"
                                                    Padding="8,2" Margin="4,0,0,0" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Find.Status}" VerticalAlignment="Center"
                                                       Margin="8,0" Foreground="{DynamicResource ScryeTextDim}" />
                                            <ToggleButton DockPanel.Dock="Right" Content="Aa" IsChecked="{Binding Find.MatchCase}"
                                                          Padding="8,2" Margin="4,0,0,0" ToolTip.Tip="Match case" />
                                            <TextBox Name="FindBox" Text="{Binding Find.Query}" PlaceholderText="find in output…"
                                                     AutomationProperties.Name="Find in output"
                                                     KeyDown="OnFindKeyDown" />
                                        </DockPanel>
                                    </Border>

                                    <Grid Margin="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="{Binding RightPanesColWidth}" />
                                        </Grid.ColumnDefinitions>

                                        <Grid Grid.Column="0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="{Binding PanesRowHeight}" />
                                            </Grid.RowDefinitions>

                                            <controls:TerminalPane Grid.Row="0" Background="{DynamicResource ScryeOutputBg}"
                                                                   Source="{Binding Scrollback}"
                                                                   FontFamily="{Binding OutputFontFamily}"
                                                                   FontSize="{Binding OutputFontSize}"
                                                                   SearchTerm="{Binding Find.Term}"
                                                                   ActiveMatchLine="{Binding Find.ActiveLine}"
                                                                   MatchCase="{Binding Find.MatchCase}"
                                                                   ShowTimestamps="{Binding ShowTimestamps}"
                                                                   CommandLinkClicked="OnCommandLinkClicked" />

                                            <GridSplitter Grid.Row="1" Height="4" IsVisible="{Binding ShowPanes}"
                                                          ResizeDirection="Rows" Background="Transparent" />

                                            <!-- bottom pane zone (right-click a tab to move/float/close) -->
                                            <TabControl Grid.Row="2" IsVisible="{Binding ShowPanes}" Padding="0"
                                                        ItemsSource="{Binding BottomPanes}" SelectedItem="{Binding SelectedBottomPane}">
                                                <TabControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:CapturePaneViewModel">
                                                        <StackPanel Orientation="Horizontal" Spacing="6" Background="Transparent">
                                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                            <Border Background="{DynamicResource ScryeBadgeBg}" CornerRadius="8" Padding="6,0"
                                                                    IsVisible="{Binding HasUnread}" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Unread}" FontSize="11" Foreground="White" />
                                                            </Border>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </TabControl.ItemTemplate>
                                                <TabControl.ContentTemplate>
                                                    <DataTemplate x:DataType="vm:CapturePaneViewModel">
                                                        <controls:TerminalPane Background="{DynamicResource ScryeOutputBg}"
                                                                               Source="{Binding Buffer}"
                                                                               FontFamily="{Binding FontFamily}"
                                                                               FontSize="{Binding FontSize}"
                                                                               ShowTimestamps="{Binding ShowTimestamps}"
                                                                           CommandLinkClicked="OnCommandLinkClicked" />
                                                    </DataTemplate>
                                                </TabControl.ContentTemplate>
                                            </TabControl>
                                        </Grid>

                                        <GridSplitter Grid.Column="1" Width="4" IsVisible="{Binding RightVisible}"
                                                      ResizeDirection="Columns" Background="Transparent" />

                                        <!-- right pane zone (right-click a tab to move/float/close) -->
                                        <TabControl Grid.Column="2" IsVisible="{Binding RightVisible}" Padding="0"
                                                    ItemsSource="{Binding RightPanes}" SelectedItem="{Binding SelectedRightPane}">
                                            <TabControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:CapturePaneViewModel">
                                                    <StackPanel Orientation="Horizontal" Spacing="6" Background="Transparent">
                                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                        <Border Background="{DynamicResource ScryeBadgeBg}" CornerRadius="8" Padding="6,0"
                                                                IsVisible="{Binding HasUnread}" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Unread}" FontSize="11" Foreground="White" />
                                                        </Border>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </TabControl.ItemTemplate>
                                            <TabControl.ContentTemplate>
                                                <DataTemplate x:DataType="vm:CapturePaneViewModel">
                                                    <controls:TerminalPane Background="{DynamicResource ScryeOutputBg}"
                                                                           Source="{Binding Buffer}"
                                                                           FontFamily="{Binding FontFamily}"
                                                                           FontSize="{Binding FontSize}"
                                                                           ShowTimestamps="{Binding ShowTimestamps}"
                                                                           CommandLinkClicked="OnCommandLinkClicked" />
                                                </DataTemplate>
                                            </TabControl.ContentTemplate>
                                        </TabControl>
                                    </Grid>
                                </DockPanel>

                                <!-- HUD overlay: plugin panels on a full-area canvas over the output.
                                     Panels are draggable by their title strip (HudDrag); positions
                                     persist per world. New panels stack down the right edge. -->
                                <ItemsControl ItemsSource="{Binding Hud.Panels}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:HudPanelViewModel">
                                            <!-- Width: the spec width until the user resizes (EffectiveWidth). Height: NaN
                                                 (auto) until the user resizes; fixed after, with scrolling inside. -->
                                            <Border behaviors:HudDrag.Enabled="True"
                                                    Background="{DynamicResource ScryePanelGlass}" BorderBrush="{DynamicResource ScryeLine}"
                                                    BorderThickness="1" CornerRadius="6" Padding="10"
                                                    Width="{Binding EffectiveWidth}" Height="{Binding UserHeight}"
                                                    Classes.hasbg="{Binding HasBackground}" Classes.hasac="{Binding HasAccent}">
                                                <!-- Plugin colour overrides. Each style only applies when the plugin set that
                                                     colour (via a toggled class), so panels without custom colours keep
                                                     following the active theme. Per-widget overrides target descendant
                                                     TextBlock/ProgressBar with class 'wc'. -->
                                                <Border.Styles>
                                                    <Style Selector="Border.hasbg">
                                                        <Setter Property="Background" Value="{Binding BackgroundBrush}" />
                                                    </Style>
                                                    <Style Selector="Border.hasac">
                                                        <Setter Property="BorderBrush" Value="{Binding AccentBrush}" />
                                                    </Style>
                                                    <Style Selector="TextBlock.hasac">
                                                        <Setter Property="Foreground" Value="{Binding AccentBrush}" />
                                                    </Style>
                                                    <!-- ReflectionBinding: these styles target the widget VMs (Label/Progress),
                                                         whose type differs from the panel's compiled x:DataType, so bind ColorBrush
                                                         at runtime against the styled control's own DataContext. -->
                                                    <Style Selector="TextBlock.wc">
                                                        <Setter Property="Foreground" Value="{ReflectionBinding ColorBrush}" />
                                                    </Style>
                                                    <Style Selector="ProgressBar.wc">
                                                        <Setter Property="Foreground" Value="{ReflectionBinding ColorBrush}" />
                                                    </Style>
                                                    <!-- resize grip: invisible until the pointer is over the panel (these
                                                         styles are scoped to this Border, so plain selectors are enough) -->
                                                    <Style Selector="Path.grip">
                                                        <Setter Property="Opacity" Value="0" />
                                                    </Style>
                                                    <Style Selector="Border:pointerover Path.grip">
                                                        <Setter Property="Opacity" Value="0.55" />
                                                    </Style>
                                                </Border.Styles>
                                                <!-- widget templates live on the Border so both the flat list and tab contents share them -->
                                                <Border.DataTemplates>
                                                    <DataTemplate DataType="vm:LabelWidgetViewModel">
                                                        <TextBlock Text="{Binding Text}" FontSize="11" Foreground="{DynamicResource ScryeText}"
                                                                   Classes.wc="{Binding HasColor}" />
                                                    </DataTemplate>
                                                    <DataTemplate DataType="vm:ProgressWidgetViewModel">
                                                        <StackPanel Spacing="1" Margin="0,1">
                                                            <TextBlock Text="{Binding Label}" FontSize="10" Foreground="{DynamicResource ScryeTextDim}" />
                                                            <Grid>
                                                                <ProgressBar Minimum="0" Maximum="{Binding Maximum}"
                                                                             Value="{Binding Value}" Height="15"
                                                                             Classes.wc="{Binding HasColor}" />
                                                                <TextBlock Text="{Binding Caption}" FontSize="10" Foreground="{DynamicResource ScryeOnBar}"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Grid>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                    <DataTemplate DataType="vm:GaugeWidgetViewModel">
                                                        <DockPanel Margin="0,1">
                                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Label}" FontSize="10" Width="52"
                                                                       Foreground="{DynamicResource ScryeTextDim}" VerticalAlignment="Center" />
                                                            <Grid>
                                                                <ProgressBar Minimum="0" Maximum="{Binding Maximum}" Value="{Binding Value}"
                                                                             Height="14" Foreground="{Binding BarBrush}" />
                                                                <TextBlock Text="{Binding Caption}" FontSize="9.5" Foreground="{DynamicResource ScryeOnBar}"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Grid>
                                                        </DockPanel>
                                                    </DataTemplate>
                                                    <!-- StyledTextView, not TextBlock: the text may carry plugin colour
                                                         markup, so runs are coloured individually. Plain text renders
                                                         exactly as it did before. -->
                                                    <DataTemplate DataType="vm:TextWidgetViewModel">
                                                        <controls:StyledTextView Text="{Binding Text}" Foreground="{Binding Foreground}"
                                                                                 LinkCommand="{Binding LinkCommand}" Margin="0,2" />
                                                    </DataTemplate>
                                                    <DataTemplate DataType="vm:ColorGridWidgetViewModel">
                                                        <controls:ColorGridView GridText="{Binding GridText}" Palette="{Binding Palette}"
                                                                                CellCommand="{Binding CellCommand}"
                                                                                HoverCommand="{Binding HoverCommand}"
                                                                                LabelChars="{Binding LabelChars}"
                                                                                Icons="{Binding Icons}"
                                                                                MaxCell="{Binding MaxCell}"
                                                                                Weave="{Binding Weave}" Margin="0,3" />
                                                    </DataTemplate>
                                                    <DataTemplate DataType="vm:BarListWidgetViewModel">
                                                        <controls:BarListView Rows="{Binding Rows}" Margin="0,3" />
                                                    </DataTemplate>
                                                    <!-- list and table widgets: one control, distinguished by the
                                                         VM's Columns/Align/DimTrailing. -->
                                                    <DataTemplate DataType="vm:TableWidgetViewModel">
                                                        <controls:DataTableView Rows="{Binding Rows}" Separator="{Binding Separator}"
                                                                                Columns="{Binding Columns}" Align="{Binding Align}"
                                                                                Foreground="{Binding ColorBrush}"
                                                                                DimTrailing="{Binding DimTrailing}" Margin="0,3" />
                                                    </DataTemplate>
                                                    <DataTemplate DataType="vm:ButtonWidgetViewModel">
                                                        <Button Content="{Binding Text}" Command="{Binding Command}"
                                                                HorizontalAlignment="Stretch" Margin="0,1" Padding="8,3" FontSize="11" />
                                                    </DataTemplate>
                                                    <DataTemplate DataType="vm:InputWidgetViewModel">
                                                        <DockPanel Margin="0,1">
                                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Prefix}" FontSize="11"
                                                                       VerticalAlignment="Center" Margin="0,0,4,0"
                                                                       Foreground="{DynamicResource ScryeTextDim}" />
                                                            <Button DockPanel.Dock="Right" Content="Set" Command="{Binding SubmitCommand}"
                                                                    Padding="8,2" FontSize="11" Margin="4,0,0,0" />
                                                            <TextBox Text="{Binding Text, Mode=TwoWay}" FontSize="11" Padding="4,2"
                                                                     KeyDown="OnInputWidgetKeyDown" />
                                                        </DockPanel>
                                                    </DataTemplate>
                                                    <!-- row container (API 1.8): children side by side, each at its measured
                                                         width — the colorgrid reports tight content size for exactly this -->
                                                    <DataTemplate DataType="vm:RowWidgetViewModel">
                                                        <ItemsControl ItemsSource="{Binding Children}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal" Spacing="10" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                        </ItemsControl>
                                                    </DataTemplate>
                                                    <DataTemplate DataType="vm:ButtonRowWidgetViewModel">
                                                        <ItemsControl ItemsSource="{Binding Buttons}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <UniformGrid Rows="1" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:ButtonWidgetViewModel">
                                                                    <Button Content="{Binding Text}" Command="{Binding Command}"
                                                                            HorizontalAlignment="Stretch" Margin="1" Padding="8,3" FontSize="11" />
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </DataTemplate>
                                                </Border.DataTemplates>
                                                <!-- Grid, not StackPanel: the content row must be CONSTRAINED when the
                                                     user fixed the panel height, or the ScrollViewers below would be
                                                     measured with infinity and never scroll. With auto height the star
                                                     row simply takes the content's size, exactly like the old stack. -->
                                                <Grid RowDefinitions="Auto,*">
                                                    <TextBlock Grid.Row="0" Text="{Binding Title}" FontWeight="SemiBold" FontSize="11"
                                                               Margin="0,0,0,4"
                                                               Foreground="{DynamicResource ScryeAccent}"
                                                               Classes.hasac="{Binding HasAccent}" />
                                                    <ScrollViewer Grid.Row="1" IsVisible="{Binding !HasTabs}"
                                                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                        <ItemsControl ItemsSource="{Binding Widgets}" />
                                                    </ScrollViewer>
                                                    <TabControl Grid.Row="1" ItemsSource="{Binding Tabs}" IsVisible="{Binding HasTabs}" Padding="0,4,0,0">
                                                        <TabControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:HudTabViewModel">
                                                                <TextBlock Text="{Binding Title}" FontSize="11" />
                                                            </DataTemplate>
                                                        </TabControl.ItemTemplate>
                                                        <TabControl.ContentTemplate>
                                                            <DataTemplate x:DataType="vm:HudTabViewModel">
                                                                <!-- Cap while the panel auto-sizes; uncapped once the user fixed the
                                                                     height (TabMaxHeight) — the panel is the constraint then. -->
                                                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                                              MaxHeight="{ReflectionBinding $parent[TabControl].DataContext.TabMaxHeight}">
                                                                    <ItemsControl ItemsSource="{Binding Widgets}" Margin="0,2,0,0" />
                                                                </ScrollViewer>
                                                            </DataTemplate>
                                                        </TabControl.ContentTemplate>
                                                    </TabControl>
                                                    <!-- resize grip glyph (hit-testing lives in HudDrag, by position) -->
                                                    <Path Grid.Row="1" Classes="grip" IsHitTestVisible="False"
                                                          HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                          Margin="0,0,-6,-6"
                                                          Data="M 0,9 L 9,0 M 3.5,9 L 9,3.5 M 7,9 L 9,7"
                                                          Stroke="{DynamicResource ScryeTextDim}" StrokeThickness="1.2" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- plugins manager: list / reload / enable-disable (Ctrl-free; toggle button) -->
                                <Border IsVisible="{Binding Plugins.IsOpen}" HorizontalAlignment="Left" VerticalAlignment="Top"
                                        Width="300" MaxHeight="380" Margin="12,10,0,0" Padding="10"
                                        Background="{DynamicResource ScryePanelGlass}" BorderBrush="{DynamicResource ScryeLine}"
                                        BorderThickness="1" CornerRadius="6">
                                    <DockPanel>
                                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                            <Button DockPanel.Dock="Right" Content="✕" Command="{Binding Plugins.CloseCommand}" Padding="6,1" />
                                            <Button DockPanel.Dock="Right" Content="↻" Command="{Binding Plugins.RescanCommand}" Padding="6,1" Margin="0,0,4,0"
                                                    ToolTip.Tip="Rescan folders + install any .scryeplugin packages dropped in" />
                                            <TextBlock Text="PLUGINS" FontWeight="SemiBold" FontSize="11"
                                                       Foreground="{DynamicResource ScryeAccent}" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="4" Margin="0,6,0,0">
                                            <Button Content="New plugin" Command="{Binding Plugins.NewCommand}" Padding="8,2" FontSize="10" />
                                            <Button Content="Open folder" Command="{Binding Plugins.OpenFolderCommand}" Padding="8,2" FontSize="10" />
                                        </StackPanel>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding Plugins.Plugins}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:PluginRowViewModel">
                                                        <Border Margin="0,0,0,4" Padding="6" CornerRadius="4"
                                                                Background="{DynamicResource ScryePanelAlt}">
                                                            <DockPanel>
                                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4">
                                                                    <Button Content="Reload" Command="{Binding ReloadCommand}" Padding="6,1" FontSize="10" />
                                                                    <Button Content="{Binding ToggleLabel}" Command="{Binding ToggleCommand}" Padding="6,1" FontSize="10" />
                                                                    <Button Content="Remove" Command="{Binding RemoveCommand}" IsVisible="{Binding Removable}"
                                                                            Padding="6,1" FontSize="10" />
                                                                </StackPanel>
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource ScryeText}" FontSize="11" />
                                                                    <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource ScryeTextDim}" FontSize="10" />
                                                                    <!-- Why a plugin is not running, when the reason is structural
                                                                         (wrong API range) rather than the user's choice. -->
                                                                    <TextBlock Text="{Binding IncompatibleReason}" IsVisible="{Binding HasIncompatibility}"
                                                                               Foreground="{DynamicResource ScryeError}" FontSize="10"
                                                                               TextWrapping="Wrap" Margin="0,2,0,0" />
                                                                    <!-- Cost/failure summary; hidden entirely when a plugin is behaving. -->
                                                                    <TextBlock Text="{Binding HealthSummary}" IsVisible="{Binding HasHealthWarning}"
                                                                               Foreground="{DynamicResource ScryeWarning}" FontSize="10"
                                                                               TextWrapping="Wrap" Margin="0,2,0,0" />
                                                                    <!-- Declared capabilities. Informational: see PluginPermissions. -->
                                                                    <TextBlock Text="{Binding PermissionSummary}" IsVisible="{Binding HasPermissions}"
                                                                               Foreground="{DynamicResource ScryeTextDim}" FontSize="10"
                                                                               TextWrapping="Wrap" Margin="0,2,0,0"
                                                                               ToolTip.Tip="{Binding PermissionDetail}" />
                                                                </StackPanel>
                                                            </DockPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </DockPanel>
                                </Border>

                                <!-- companion: phone server status, how to reach it, and what notifies.
                                     Replaces printing the access token into scrollback, which session
                                     logging would otherwise write to disk. -->
                                <Border IsVisible="{Binding CompanionPanel.IsOpen}" HorizontalAlignment="Left" VerticalAlignment="Top"
                                        Width="330" MaxHeight="560" Margin="12,10,0,0" Padding="10"
                                        Background="{DynamicResource ScryePanelGlass}" BorderBrush="{DynamicResource ScryeLine}"
                                        BorderThickness="1" CornerRadius="6">
                                    <DockPanel>
                                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                            <Button DockPanel.Dock="Right" Content="✕" Command="{Binding CompanionPanel.CloseCommand}" Padding="6,1" />
                                            <Button DockPanel.Dock="Right" Content="↻" Command="{Binding CompanionPanel.RefreshCommand}" Padding="6,1" Margin="0,0,4,0"
                                                    ToolTip.Tip="Re-check the server, Tailscale and the notify list" />
                                            <TextBlock Text="COMPANION" FontWeight="SemiBold" FontSize="11"
                                                       Foreground="{DynamicResource ScryeAccent}" VerticalAlignment="Center" />
                                        </DockPanel>

                                        <TextBlock DockPanel.Dock="Bottom" Text="{Binding CompanionPanel.Notice}" FontSize="10"
                                                   Foreground="{DynamicResource ScryeAccent}" TextWrapping="Wrap" Margin="0,6,0,0"
                                                   IsVisible="{Binding CompanionPanel.Notice, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />

                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <StackPanel Spacing="6">

                                                <!-- server -->
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Content="Start" Command="{Binding CompanionPanel.StartCommand}"
                                                            IsVisible="{Binding CompanionPanel.IsStopped}" Padding="10,2" FontSize="10" />
                                                    <Button DockPanel.Dock="Right" Content="Stop" Command="{Binding CompanionPanel.StopCommand}"
                                                            IsVisible="{Binding CompanionPanel.IsRunning}" Padding="10,2" FontSize="10" />
                                                    <TextBlock Text="{Binding CompanionPanel.StatusText}" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource ScryeText}" FontSize="11" />
                                                </DockPanel>

                                                <TextBlock Text="{Binding CompanionPanel.LocalUrl}" FontSize="10" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource ScryeTextDim}"
                                                           IsVisible="{Binding CompanionPanel.IsRunning}" />

                                                <!-- reaching it from a phone -->
                                                <Border Background="{DynamicResource ScryePanelAlt}" CornerRadius="4" Padding="8"
                                                        IsVisible="{Binding CompanionPanel.IsRunning}">
                                                    <StackPanel Spacing="5">
                                                        <TextBlock Text="ON YOUR PHONE" FontSize="10" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource ScryeAccent}" />

                                                        <controls:QrCodeView Text="{Binding CompanionPanel.QrPayload}"
                                                                             Height="200" HorizontalAlignment="Center"
                                                                             IsVisible="{Binding CompanionPanel.HasPhoneUrl}" />

                                                        <TextBlock Text="{Binding CompanionPanel.PhoneUrl}" FontSize="10" TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource ScryeText}"
                                                                   IsVisible="{Binding CompanionPanel.HasPhoneUrl}" />

                                                        <TextBlock Text="{Binding CompanionPanel.TailscaleStatusText}" FontSize="10" TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource ScryeTextDim}"
                                                                   IsVisible="{Binding !CompanionPanel.HasPhoneUrl}" />

                                                        <StackPanel Orientation="Horizontal" Spacing="4"
                                                                    IsVisible="{Binding CompanionPanel.HasPhoneUrl}">
                                                            <Button Content="Copy address" Command="{Binding CompanionPanel.CopyUrlCommand}"
                                                                    Padding="8,2" FontSize="10" />
                                                        </StackPanel>

                                                        <TextBlock Text="Tailscale is not serving yet — run this in a terminal:"
                                                                   FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource ScryeTextDim}"
                                                                   IsVisible="{Binding CompanionPanel.HasServeCommand}" />
                                                        <TextBox Text="{Binding CompanionPanel.ServeCommandText, Mode=OneWay}" IsReadOnly="True"
                                                                 FontSize="10" FontFamily="Consolas, monospace" TextWrapping="Wrap"
                                                                 IsVisible="{Binding CompanionPanel.HasServeCommand}" />
                                                        <Button Content="Copy command" Command="{Binding CompanionPanel.CopyServeCommand}"
                                                                Padding="8,2" FontSize="10" HorizontalAlignment="Left"
                                                                IsVisible="{Binding CompanionPanel.HasServeCommand}" />
                                                    </StackPanel>
                                                </Border>

                                                <!-- how the phone authenticates -->
                                                <Border Background="{DynamicResource ScryePanelAlt}" CornerRadius="4" Padding="8"
                                                        IsVisible="{Binding CompanionPanel.IsRunning}">
                                                    <StackPanel Spacing="5">
                                                        <TextBlock Text="ACCESS" FontSize="10" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource ScryeAccent}" />
                                                        <TextBlock FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource ScryeText}"
                                                                   IsVisible="{Binding CompanionPanel.HasTrustedLogin}"
                                                                   Text="{Binding CompanionPanel.TrustedLogin, StringFormat='{}{0} connects without a token.'}" />
                                                        <TextBlock Text="Token — only needed off-tailnet. Changes every start."
                                                                   FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource ScryeTextDim}" />
                                                        <TextBox Text="{Binding CompanionPanel.Token, Mode=OneWay}" IsReadOnly="True"
                                                                 FontSize="10" FontFamily="Consolas, monospace" TextWrapping="Wrap"
                                                                 IsVisible="{Binding CompanionPanel.HasToken}" />
                                                        <Button Content="Copy token" Command="{Binding CompanionPanel.CopyTokenCommand}"
                                                                Padding="8,2" FontSize="10" HorizontalAlignment="Left"
                                                                IsVisible="{Binding CompanionPanel.HasToken}" />
                                                        <TextBlock FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource ScryeTextDim}"
                                                                   Text="{Binding CompanionPanel.SessionIdText, StringFormat='This tab is session: {0}'}" />
                                                    </StackPanel>
                                                </Border>

                                                <!-- notifications -->
                                                <Border Background="{DynamicResource ScryePanelAlt}" CornerRadius="4" Padding="8">
                                                    <StackPanel Spacing="5">
                                                        <TextBlock Text="NOTIFICATIONS" FontSize="10" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource ScryeAccent}" />
                                                        <TextBlock Text="{Binding CompanionPanel.PushDevicesText}" FontSize="10"
                                                                   TextWrapping="Wrap" Foreground="{DynamicResource ScryeText}" />
                                                        <Button Content="Send a test notification" Command="{Binding CompanionPanel.TestNotifyCommand}"
                                                                IsEnabled="{Binding CompanionPanel.CanTestNotify}"
                                                                Padding="8,2" FontSize="10" HorizontalAlignment="Left" />
                                                        <TextBlock Text="{Binding CompanionPanel.NotifySummary}" FontSize="10"
                                                                   TextWrapping="Wrap" Foreground="{DynamicResource ScryeTextDim}" />
                                                        <ItemsControl ItemsSource="{Binding CompanionPanel.NotifySources}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:NotifySourceRow">
                                                                    <DockPanel Margin="0,2,0,0">
                                                                        <!-- TODO(theme): bespoke colour below, intent unclear. Left as-is pending a decision on whether it should be a semantic token. -->
                                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding StateLabel}" FontSize="9"
                                                                                   Foreground="#C08A5A" VerticalAlignment="Center" Margin="4,0,0,0" />
                                                                        <StackPanel>
                                                                            <TextBlock Text="{Binding Name}" FontSize="10"
                                                                                       Foreground="{DynamicResource ScryeText}" />
                                                                            <TextBlock Text="{Binding Detail}" FontSize="9" TextTrimming="CharacterEllipsis"
                                                                                       Foreground="{DynamicResource ScryeTextDim}" />
                                                                        </StackPanel>
                                                                    </DockPanel>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>

                                                <!-- plugin-reported notification sources (plugin.<id>.notify convention):
                                                     each on/off row IS the switch — the button runs the plugin's own
                                                     toggle alias through the input pipeline and re-reads the state. -->
                                                <Border Background="{DynamicResource ScryePanelAlt}" CornerRadius="4" Padding="8"
                                                        IsVisible="{Binding CompanionPanel.HasPluginSources}">
                                                    <StackPanel Spacing="5">
                                                        <TextBlock Text="PLUGIN SOURCES" FontSize="10" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource ScryeAccent}" />
                                                        <ItemsControl ItemsSource="{Binding CompanionPanel.PluginSources}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:PluginNotifyGroup">
                                                                    <StackPanel Margin="0,0,0,4">
                                                                        <TextBlock Text="{Binding PluginId}" FontSize="9" FontWeight="SemiBold"
                                                                                   Foreground="{DynamicResource ScryeTextDim}" Margin="0,2,0,1" />
                                                                        <ItemsControl ItemsSource="{Binding Rows}">
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate x:DataType="vm:PluginNotifyRow">
                                                                                    <DockPanel Margin="0,1,0,0">
                                                                                        <Button DockPanel.Dock="Right" Content="on"
                                                                                                Command="{Binding Toggle}"
                                                                                                IsVisible="{Binding IsOn}"
                                                                                                Foreground="{DynamicResource ScryeSuccess}"
                                                                                                FontSize="9" Padding="8,1" MinWidth="34"
                                                                                                HorizontalContentAlignment="Center"
                                                                                                VerticalAlignment="Center" Margin="4,0,0,0"
                                                                                                ToolTip.Tip="Tap to turn off" />
                                                                                        <Button DockPanel.Dock="Right" Content="off"
                                                                                                Command="{Binding Toggle}"
                                                                                                IsVisible="{Binding IsOff}"
                                                                                                Foreground="{DynamicResource ScryeTextDim}"
                                                                                                FontSize="9" Padding="8,1" MinWidth="34"
                                                                                                HorizontalContentAlignment="Center"
                                                                                                VerticalAlignment="Center" Margin="4,0,0,0"
                                                                                                ToolTip.Tip="Tap to turn on" />
                                                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding State}" FontSize="9"
                                                                                                   Foreground="{DynamicResource ScryeTextDim}"
                                                                                                   IsVisible="{Binding !CanToggle}"
                                                                                                   VerticalAlignment="Center" Margin="4,0,0,0" />
                                                                                        <StackPanel>
                                                                                            <TextBlock Text="{Binding Label}" FontSize="10"
                                                                                                       Foreground="{DynamicResource ScryeText}" />
                                                                                            <TextBlock Text="{Binding Detail}" FontSize="9" TextWrapping="Wrap"
                                                                                                       Foreground="{DynamicResource ScryeTextDim}"
                                                                                                       IsVisible="{Binding HasDetail}" />
                                                                                        </StackPanel>
                                                                                    </DockPanel>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>

                                            </StackPanel>
                                        </ScrollViewer>
                                    </DockPanel>
                                </Border>

                                <!-- game-state inspector overlay (idea #9): live GMCP/MIP paths -->
                                <Border IsVisible="{Binding StateInspector.IsOpen}" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                        Width="380" Margin="12,10,0,44" Padding="10"
                                        Background="{DynamicResource ScryePanelGlass}" BorderBrush="{DynamicResource ScryeLine}"
                                        BorderThickness="1" CornerRadius="6">
                                    <DockPanel>
                                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                            <Button DockPanel.Dock="Right" Content="✕" Command="{Binding StateInspector.CloseCommand}" Padding="6,1" />
                                            <TextBlock Text="GAME STATE" FontWeight="SemiBold" FontSize="11"
                                                       Foreground="{DynamicResource ScryeAccent}" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <TextBox DockPanel.Dock="Top" Text="{Binding StateInspector.Filter}" PlaceholderText="filter paths and values…"
                                                 FontSize="11" Margin="0,0,0,6" />
                                        <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0" Spacing="2">
                                            <SelectableTextBlock Text="{Binding StateInspector.Detail}" FontFamily="Cascadia Mono, Consolas, monospace"
                                                                 FontSize="11" Foreground="{DynamicResource ScryeText}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding StateInspector.Status}" FontSize="10"
                                                       Foreground="{DynamicResource ScryeTextDim}" />
                                        </StackPanel>
                                        <ListBox ItemsSource="{Binding StateInspector.Rows}" SelectedItem="{Binding StateInspector.SelectedRow}"
                                                 Background="Transparent" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="11">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:StateRowViewModel">
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" Foreground="{DynamicResource ScryeText}"
                                                                   Margin="8,0,0,0" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Path}" Foreground="{DynamicResource ScryeTextDim}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </DockPanel>
                                </Border>
                            </Grid>

                            <!-- drag handle to resize the debugger panel -->
                            <GridSplitter Grid.Column="1" Width="5" ResizeDirection="Columns"
                                          Background="{DynamicResource ScryeLine}" IsVisible="{Binding ShowDebugger}" />

                            <!-- debugger (toggle-able, resizable): Live timeline + Replay transport -->
                            <Border Grid.Column="2" MinWidth="280" IsVisible="{Binding ShowDebugger}"
                                    Background="{DynamicResource ScryePanel}" BorderBrush="{DynamicResource ScryeLine}"
                                    BorderThickness="1,0,0,0" Padding="6">
                                <TabControl>
                                    <!-- LIVE: the running event timeline -->
                                    <TabItem Header="Live">
                                        <DockPanel>
                                            <!-- category filters -->
                                            <WrapPanel DockPanel.Dock="Top" Margin="0,4,0,4">
                                                <CheckBox Content="Output" IsChecked="{Binding Debugger.ShowOutput}" Margin="0,0,6,0" />
                                                <CheckBox Content="Input" IsChecked="{Binding Debugger.ShowInput}" Margin="0,0,6,0" />
                                                <CheckBox Content="Auto" IsChecked="{Binding Debugger.ShowAutomation}" Margin="0,0,6,0" />
                                                <CheckBox Content="State" IsChecked="{Binding Debugger.ShowState}" Margin="0,0,6,0" />
                                                <CheckBox Content="Proto" IsChecked="{Binding Debugger.ShowProtocol}" Margin="0,0,6,0" />
                                                <CheckBox Content="Sys" IsChecked="{Binding Debugger.ShowSystem}" Margin="0,0,6,0" />
                                            </WrapPanel>

                                            <!-- transport controls -->
                                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,4">
                                                <ToggleButton Content="Pause" IsChecked="{Binding Debugger.Paused}" />
                                                <Button Content="{Binding Debugger.RecordLabel}" Command="{Binding Debugger.RecordCommand}" />
                                                <Button Content="Clear" Command="{Binding Debugger.ClearCommand}" />
                                            </StackPanel>

                                            <!-- simulate a line against the triggers (dry-run) -->
                                            <DockPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
                                                <Button DockPanel.Dock="Right" Content="Simulate"
                                                        Command="{Binding Debugger.SimulateCommand}" Margin="4,0,0,0" />
                                                <TextBox Text="{Binding Debugger.SimulateInput}"
                                                         PlaceholderText="test a line against triggers…" />
                                            </DockPanel>

                                            <!-- drill-down: full text of the selected row (fixes truncation) -->
                                            <Border DockPanel.Dock="Bottom" Margin="0,4,0,0" Padding="6"
                                                    Background="{DynamicResource ScryeInsetBg}" BorderBrush="{DynamicResource ScryeLine}" BorderThickness="1"
                                                    IsVisible="{Binding Debugger.SelectedRow, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                                                <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
                                                    <SelectableTextBlock Text="{Binding Debugger.SelectedRow.Full}" TextWrapping="Wrap"
                                                                         FontFamily="Cascadia Mono, Consolas, monospace" FontSize="11" Foreground="{DynamicResource ScryeText}" />
                                                </ScrollViewer>
                                            </Border>

                                            <!-- the event stream -->
                                            <ListBox ItemsSource="{Binding Debugger.Rows}" SelectedItem="{Binding Debugger.SelectedRow}"
                                                     behaviors:AutoScroll.Enabled="True"
                                                     Background="{DynamicResource ScryeOutputBg}" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="11">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:EventRowViewModel">
                                                        <TextBlock Text="{Binding Display}" Foreground="{Binding Brush}" />
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </DockPanel>
                                    </TabItem>

                                    <!-- REPLAY: load a recording, step through it, re-run vs current triggers -->
                                    <TabItem Header="Replay">
                                        <DockPanel>
                                            <!-- recording picker -->
                                            <DockPanel DockPanel.Dock="Top" Margin="0,4,0,4">
                                                <Button DockPanel.Dock="Right" Content="Load"
                                                        Command="{Binding Replay.LoadCommand}" Margin="4,0,0,0" />
                                                <Button DockPanel.Dock="Right" Content="↻"
                                                        Command="{Binding Replay.RefreshCommand}" Margin="4,0,0,0" />
                                                <ComboBox ItemsSource="{Binding Replay.Recordings}"
                                                          SelectedItem="{Binding Replay.SelectedRecording}"
                                                          HorizontalAlignment="Stretch" />
                                            </DockPanel>

                                            <!-- transport -->
                                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,4">
                                                <Button Content="{Binding Replay.PlayLabel}" Command="{Binding Replay.PlayPauseCommand}" />
                                                <Button Content="Step" Command="{Binding Replay.StepCommand}" />
                                                <Button Content="Restart" Command="{Binding Replay.RestartCommand}" />
                                                <ComboBox ItemsSource="{Binding Replay.SpeedOptions}" SelectedItem="{Binding Replay.Speed}"
                                                          Width="64" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Replay.PositionLabel}" VerticalAlignment="Center" Foreground="{DynamicResource ScryeTextDim}" />
                                            </StackPanel>

                                            <!-- scrub the timeline -->
                                            <Slider DockPanel.Dock="Top" Minimum="0" Maximum="{Binding Replay.Total}"
                                                    Value="{Binding Replay.Position, Mode=TwoWay}" Margin="0,0,0,4" />

                                            <TextBlock DockPanel.Dock="Top" Text="{Binding Replay.Status}"
                                                       TextWrapping="Wrap" Foreground="{DynamicResource ScryeTextDim}" Margin="0,0,0,4" />

                                            <!-- the killer feature -->
                                            <Button DockPanel.Dock="Bottom" Margin="0,4,0,0" HorizontalAlignment="Stretch"
                                                    Content="Re-run vs current triggers" Command="{Binding Replay.AnalyzeCommand}" />

                                            <!-- diff results from the re-run -->
                                            <Border DockPanel.Dock="Bottom" IsVisible="{Binding Replay.HasDiffs}" Margin="0,4,0,0" Padding="6"
                                                    Background="{DynamicResource ScryeOutputBg}" BorderBrush="{DynamicResource ScryeLine}" BorderThickness="1">
                                                <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto">
                                                    <ItemsControl ItemsSource="{Binding Replay.DiffLines}" x:CompileBindings="False">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <!-- TODO(theme): bespoke colour for replay diff text; no semantic token fits yet. -->
                                                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="#E0B0FF"
                                                                           FontFamily="Cascadia Mono, Consolas, monospace" FontSize="11" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </Border>

                                            <!-- drill-down: full text of the selected recorded row -->
                                            <Border DockPanel.Dock="Bottom" Margin="0,4,0,0" Padding="6"
                                                    Background="{DynamicResource ScryeInsetBg}" BorderBrush="{DynamicResource ScryeLine}" BorderThickness="1"
                                                    IsVisible="{Binding Replay.SelectedRow, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                                                <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
                                                    <SelectableTextBlock Text="{Binding Replay.SelectedRow.Full}" TextWrapping="Wrap"
                                                                         FontFamily="Cascadia Mono, Consolas, monospace" FontSize="11" Foreground="{DynamicResource ScryeText}" />
                                                </ScrollViewer>
                                            </Border>

                                            <!-- recorded events, revealed up to the current position -->
                                            <ListBox ItemsSource="{Binding Replay.Rows}" SelectedItem="{Binding Replay.SelectedRow}"
                                                     behaviors:AutoScroll.Enabled="True"
                                                     Background="{DynamicResource ScryeOutputBg}" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="11">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:EventRowViewModel">
                                                        <TextBlock Text="{Binding Display}" Foreground="{Binding Brush}" />
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </DockPanel>
                                    </TabItem>
                                </TabControl>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>
        </DockPanel>

        <!-- settings form overlay -->
        <Border IsVisible="{Binding Editor, Converter={x:Static conv:ObjectConverters.IsNotNull}}"
                Background="{DynamicResource ScryeScrim}">
            <Border Width="700" MaxHeight="640" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource ScryePanel}" BorderBrush="{DynamicResource ScryeLine}"
                    BorderThickness="1" CornerRadius="8" Padding="18">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding Editor.Title}" FontWeight="SemiBold" FontSize="16"
                               Foreground="{DynamicResource ScryeAccent}" Margin="0,0,0,2" />
                    <TextBlock DockPanel.Dock="Top" Text="{Binding Editor.Subtitle}" FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource ScryeTextDim}" Margin="0,0,0,8" />

                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8"
                                HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="Cancel" Command="{Binding CancelEditorCommand}" />
                        <Button Content="Save" Command="{Binding SaveEditorCommand}" />
                    </StackPanel>

                    <TabControl>
                        <!-- CONNECTION -->
                        <TabItem Header="Connection">
                            <StackPanel Spacing="6" Margin="0,8,0,0">
                                <TextBlock Text="Name" />
                                <TextBox Text="{Binding Editor.Name}" />
                                <TextBlock Text="Host" />
                                <TextBox Text="{Binding Editor.Host}" />
                                <TextBlock Text="Port" />
                                <TextBox Text="{Binding Editor.Port}" />
                                <TextBlock Text="Username (auto-login, optional)" />
                                <TextBox Text="{Binding Editor.Username}" />
                                <TextBlock Text="Password (auto-login, optional)" />
                                <TextBox Text="{Binding Editor.Password}" PasswordChar="●"
                                         PlaceholderText="{Binding Editor.PasswordHint}" />
                                <TextBlock Text="Encoding" />
                                <TextBox Text="{Binding Editor.Encoding}" />
                                <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
                                    <CheckBox Content="TLS" IsChecked="{Binding Editor.UseTls}" />
                                    <CheckBox Content="MIP (3Scapes)" IsChecked="{Binding Editor.EnableMip}" />
                                    <CheckBox Content="MXP" IsChecked="{Binding Editor.EnableMxp}"
                                              ToolTip.Tip="Clickable links + inline markup when the server supports it" />
                                    <CheckBox Content="MSP" IsChecked="{Binding Editor.EnableMsp}"
                                              ToolTip.Tip="Play !!SOUND(…) directives from the server (sounds folder: %APPDATA%\Scrye\sounds)" />
                                </StackPanel>
                            </StackPanel>
                        </TabItem>

                        <!-- TRIGGERS -->
                        <TabItem Header="Triggers">
                            <Grid ColumnDefinitions="220,*" Margin="0,8,0,0">
                                <DockPanel Grid.Column="0" Margin="0,0,10,0">
                                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                                        <Button Content="Add" Command="{Binding Editor.AddTriggerCommand}" />
                                        <Button Content="Remove" Command="{Binding Editor.RemoveTriggerCommand}" />
                                    </StackPanel>
                                    <ListBox ItemsSource="{Binding Editor.Triggers}" SelectedItem="{Binding Editor.SelectedTrigger}"
                                             Height="420" Background="{DynamicResource ScryeInsetBg}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:TriggerRowViewModel">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource ScryeText}" />
                                                    <TextBlock Text="{Binding Pattern}" FontSize="10" Foreground="{DynamicResource ScryeTextDim}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                                <Border Grid.Column="1" DataContext="{Binding Editor.SelectedTrigger}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel Spacing="4" x:DataType="vm:TriggerRowViewModel" IsVisible="{Binding Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                                            <TextBlock Text="Name" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                            <TextBox Text="{Binding Name}" />
                                            <TextBlock Text="Pattern (line to match)" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                            <TextBox Text="{Binding Pattern}" />
                                            <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,2">
                                                <CheckBox Content="Regex" IsChecked="{Binding IsRegex}" />
                                                <CheckBox Content="Ignore case" IsChecked="{Binding IgnoreCase}" />
                                                <CheckBox Content="Enabled" IsChecked="{Binding Enabled}" />
                                            </StackPanel>
                                            <TextBlock Text="Send to" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                            <ComboBox ItemsSource="{x:Static vm:RuleRowViewModel.SendToValues}" SelectedItem="{Binding SendTo}"
                                                      HorizontalAlignment="Left" Width="180" />
                                            <TextBlock Text="Send (text / %1 %&lt;name&gt; ${var} template — one command per line)" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                            <TextBox Text="{Binding Send}" AcceptsReturn="True" TextWrapping="NoWrap"
                                                     MinHeight="52" MaxHeight="100" VerticalContentAlignment="Top" />
                                            <Grid ColumnDefinitions="*,*" Margin="0,2,0,0">
                                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                    <TextBlock Text="Variable (for Variable)" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                                    <TextBox Text="{Binding Variable}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                    <TextBlock Text="Script fn (for Script)" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                                    <TextBox Text="{Binding Script}" />
                                                </StackPanel>
                                            </Grid>
                                            <Grid ColumnDefinitions="*,*" Margin="0,2,0,0">
                                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                    <TextBlock Text="Group" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                                    <TextBox Text="{Binding Group}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                    <TextBlock Text="Sequence (lower first)" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                                    <TextBox Text="{Binding SequenceText}" />
                                                </StackPanel>
                                            </Grid>
                                            <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                    <TextBlock Text="Capture to pane (routes matched line; empty = none)" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                                    <TextBox Text="{Binding CapturePane}" PlaceholderText="e.g. Chats" />
                                                </StackPanel>
                                                <CheckBox Grid.Column="1" Content="Gag from main output" IsChecked="{Binding Gag}"
                                                          VerticalAlignment="Bottom" Margin="6,0,0,4" />
                                            </Grid>
                                            <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                    <TextBlock Text="Sound on match (beep, path, or sounds-folder file)" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                                    <TextBox Text="{Binding Sound}" PlaceholderText="e.g. beep or alert.wav" />
                                                </StackPanel>
                                                <CheckBox Grid.Column="1" Content="Notify (toast, flash, phone)" IsChecked="{Binding Notify}"
                                                          VerticalAlignment="Bottom" Margin="6,0,0,4" />
                                            </Grid>
                                            <Grid ColumnDefinitions="*,*,Auto" Margin="0,2,0,0">
                                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                    <TextBlock Text="Highlight colour (#RRGGBB; empty = off)" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                                    <!-- The hex below is example text shown to the user, not a UI colour: it tells them what format this field expects. Deliberately not themed. -->
                                                    <TextBox Text="{Binding HighlightColor}" PlaceholderText="#FFD040" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                                    <TextBlock Text="Highlight background (optional)" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                                    <TextBox Text="{Binding HighlightBack}" PlaceholderText="#400000" />
                                                </StackPanel>
                                                <CheckBox Grid.Column="2" Content="Whole line" IsChecked="{Binding HighlightWholeLine}"
                                                          VerticalAlignment="Bottom" Margin="6,0,0,4"
                                                          ToolTip.Tip="On: recolour the whole line. Off: only the matched text." />
                                            </Grid>
                                            <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,2">
                                                <CheckBox Content="Keep evaluating" IsChecked="{Binding KeepEvaluating}" />
                                                <CheckBox Content="One-shot" IsChecked="{Binding OneShot}" />
                                            </StackPanel>
                                            <Border Background="{DynamicResource ScryeInsetBg}" BorderBrush="{DynamicResource ScryeLine}"
                                                    BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,6,0,0">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="Test pattern" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                                    <DockPanel>
                                                        <Button DockPanel.Dock="Right" Content="Test" Command="{Binding TestCommand}" Margin="4,0,0,0" />
                                                        <TextBox Text="{Binding TestInput}" PlaceholderText="sample line to match…" />
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding TestResult}" Foreground="{DynamicResource ScryeText}" FontSize="11" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </TabItem>

                        <!-- ALIASES -->
                        <TabItem Header="Aliases">
                            <Grid ColumnDefinitions="220,*" Margin="0,8,0,0">
                                <DockPanel Grid.Column="0" Margin="0,0,10,0">
                                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                                        <Button Content="Add" Command="{Binding Editor.AddAliasCommand}" />
                                        <Button Content="Remove" Command="{Binding Editor.RemoveAliasCommand}" />
                                    </StackPanel>
                                    <ListBox ItemsSource="{Binding Editor.Aliases}" SelectedItem="{Binding Editor.SelectedAlias}"
                                             Height="420" Background="{DynamicResource ScryeInsetBg}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:AliasRowViewModel">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource ScryeText}" />
                                                    <TextBlock Text="{Binding Pattern}" FontSize="10" Foreground="{DynamicResource ScryeTextDim}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                                <Border Grid.Column="1" DataContext="{Binding Editor.SelectedAlias}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel Spacing="4" x:DataType="vm:AliasRowViewModel" IsVisible="{Binding Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                                            <TextBlock Text="Name" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                            <TextBox Text="{Binding Name}" />
                                            <TextBlock Text="Pattern (typed command to match)" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                            <TextBox Text="{Binding Pattern}" />
                                            <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,2">
                                                <CheckBox Content="Regex" IsChecked="{Binding IsRegex}" />
                                                <CheckBox Content="Ignore case" IsChecked="{Binding IgnoreCase}" />
                                                <CheckBox Content="Enabled" IsChecked="{Binding Enabled}" />
                                            </StackPanel>
                                            <TextBlock Text="Send to" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                            <ComboBox ItemsSource="{x:Static vm:RuleRowViewModel.SendToValues}" SelectedItem="{Binding SendTo}"
                                                      HorizontalAlignment="Left" Width="180" />
                                            <TextBlock Text="Send (text / %1 %&lt;name&gt; ${var} template — one command per line)" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                            <TextBox Text="{Binding Send}" AcceptsReturn="True" TextWrapping="NoWrap"
                                                     MinHeight="52" MaxHeight="100" VerticalContentAlignment="Top" />
                                            <Grid ColumnDefinitions="*,*" Margin="0,2,0,0">
                                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                    <TextBlock Text="Variable (for Variable)" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                                    <TextBox Text="{Binding Variable}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                    <TextBlock Text="Script fn (for Script)" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                                    <TextBox Text="{Binding Script}" />
                                                </StackPanel>
                                            </Grid>
                                            <Grid ColumnDefinitions="*,*" Margin="0,2,0,0">
                                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                    <TextBlock Text="Group" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                                    <TextBox Text="{Binding Group}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                    <TextBlock Text="Sequence (lower first)" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                                    <TextBox Text="{Binding SequenceText}" />
                                                </StackPanel>
                                            </Grid>
                                            <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,2">
                                                <CheckBox Content="Keep evaluating" IsChecked="{Binding KeepEvaluating}" />
                                                <CheckBox Content="One-shot" IsChecked="{Binding OneShot}" />
                                            </StackPanel>
                                            <Border Background="{DynamicResource ScryeInsetBg}" BorderBrush="{DynamicResource ScryeLine}"
                                                    BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,6,0,0">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="Test pattern" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                                    <DockPanel>
                                                        <Button DockPanel.Dock="Right" Content="Test" Command="{Binding TestCommand}" Margin="4,0,0,0" />
                                                        <TextBox Text="{Binding TestInput}" PlaceholderText="sample line to match…" />
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding TestResult}" Foreground="{DynamicResource ScryeText}" FontSize="11" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </TabItem>

                        <!-- TIMERS -->
                        <TabItem Header="Timers">
                            <Grid ColumnDefinitions="220,*" Margin="0,8,0,0">
                                <DockPanel Grid.Column="0" Margin="0,0,10,0">
                                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                                        <Button Content="Add" Command="{Binding Editor.AddTimerCommand}" />
                                        <Button Content="Remove" Command="{Binding Editor.RemoveTimerCommand}" />
                                    </StackPanel>
                                    <ListBox ItemsSource="{Binding Editor.Timers}" SelectedItem="{Binding Editor.SelectedTimer}"
                                             Height="420" Background="{DynamicResource ScryeInsetBg}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:TimerRowViewModel">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource ScryeText}" />
                                                    <TextBlock Text="{Binding IntervalText}" FontSize="10" Foreground="{DynamicResource ScryeTextDim}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                                <Border Grid.Column="1" DataContext="{Binding Editor.SelectedTimer}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel Spacing="4" x:DataType="vm:TimerRowViewModel" IsVisible="{Binding Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                                            <TextBlock Text="Name" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                            <TextBox Text="{Binding Name}" />
                                            <TextBlock Text="Interval (seconds)" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                            <TextBox Text="{Binding IntervalText}" HorizontalAlignment="Left" Width="120" />
                                            <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,2">
                                                <CheckBox Content="Enabled" IsChecked="{Binding Enabled}" />
                                                <CheckBox Content="One-shot" IsChecked="{Binding OneShot}" />
                                            </StackPanel>
                                            <TextBlock Text="Send to" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                            <ComboBox ItemsSource="{x:Static vm:TimerRowViewModel.SendToValues}" SelectedItem="{Binding SendTo}"
                                                      HorizontalAlignment="Left" Width="180" />
                                            <TextBlock Text="Send (text / template — one command per line)" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                            <TextBox Text="{Binding Send}" AcceptsReturn="True" TextWrapping="NoWrap"
                                                     MinHeight="52" MaxHeight="100" VerticalContentAlignment="Top" />
                                            <Grid ColumnDefinitions="*,*" Margin="0,2,0,0">
                                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                    <TextBlock Text="Variable (for Variable)" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                                    <TextBox Text="{Binding Variable}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                    <TextBlock Text="Script fn (for Script)" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                                    <TextBox Text="{Binding Script}" />
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="Group" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                            <TextBox Text="{Binding Group}" />
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </TabItem>

                        <!-- SEQUENCES -->
                        <TabItem Header="Sequences">
                            <Grid ColumnDefinitions="220,*" Margin="0,8,0,0">
                                <DockPanel Grid.Column="0" Margin="0,0,10,0">
                                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                                        <Button Content="Add" Command="{Binding Editor.AddSequenceCommand}" />
                                        <Button Content="Remove" Command="{Binding Editor.RemoveSequenceCommand}" />
                                    </StackPanel>
                                    <ListBox ItemsSource="{Binding Editor.Sequences}" SelectedItem="{Binding Editor.SelectedSequence}"
                                             Height="420" Background="{DynamicResource ScryeInsetBg}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:SequenceRowViewModel">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource ScryeText}" />
                                                    <TextBlock Text="{Binding Source}" FontSize="10" Foreground="{DynamicResource ScryeTextDim}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                                <Border Grid.Column="1" DataContext="{Binding Editor.SelectedSequence}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel Spacing="4" x:DataType="vm:SequenceRowViewModel" IsVisible="{Binding Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                                            <TextBlock Text="Name — run in-game with  .seq &lt;name&gt;" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                            <TextBox Text="{Binding Name}" />
                                            <TextBlock Text="Steps" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                            <TextBox Text="{Binding Source}" AcceptsReturn="True" TextWrapping="Wrap" Height="130"
                                                     FontFamily="Cascadia Mono, Consolas, monospace" />
                                            <CheckBox Content="Wait for the room prompt between steps" IsChecked="{Binding PromptGated}" Margin="0,2" />
                                            <Grid ColumnDefinitions="*,*" Margin="0,2,0,0">
                                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                    <TextBlock Text="Prompt timeout (s)" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                                    <TextBox Text="{Binding TimeoutText}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                    <TextBlock Text="Step delay when ungated (s)" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                                    <TextBox Text="{Binding DelayText}" />
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="Separate steps with ; or new lines. Repeat with  x3  or  *3. Delay with  wait 2 / pause 1.5."
                                                       Foreground="{DynamicResource ScryeTextDim}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </Border>
        </Border>

        <!-- quick-connect dialog: the old top bar's host/port/TLS/MIP, on demand -->
        <Border IsVisible="{Binding QuickConnectOpen}" Background="{DynamicResource ScryeScrim}">
            <Border Width="320" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource ScryePanel}" BorderBrush="{DynamicResource ScryeLine}"
                    BorderThickness="1" CornerRadius="8" Padding="18">
                <StackPanel Spacing="8">
                    <TextBlock Text="Quick Connect" FontWeight="SemiBold" FontSize="16"
                               Foreground="{DynamicResource ScryeAccent}" />
                    <TextBlock Text="Session-only: nothing is saved. Use a profile for worlds you keep."
                               FontSize="11" Foreground="{DynamicResource ScryeTextDim}" TextWrapping="Wrap" />
                    <TextBox PlaceholderText="host" Text="{Binding Host}" AutomationProperties.Name="Host" />
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Right" Content="MIP" IsChecked="{Binding EnableMip}"
                                  Margin="8,0,0,0" VerticalAlignment="Center"
                                  ToolTip.Tip="3Scapes MIP feed (state for the bundled plugins)" />
                        <CheckBox DockPanel.Dock="Right" Content="TLS" IsChecked="{Binding UseTls}"
                                  Margin="8,0,0,0" VerticalAlignment="Center" />
                        <TextBox PlaceholderText="port" Text="{Binding Port}" AutomationProperties.Name="Port" />
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,6,0,0">
                        <Button Content="Cancel" Command="{Binding CancelQuickConnectCommand}" />
                        <Button Content="Connect" Command="{Binding ConnectCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- global settings overlay -->
        <Border IsVisible="{Binding Settings, Converter={x:Static conv:ObjectConverters.IsNotNull}}"
                Background="{DynamicResource ScryeScrim}">
            <Border Width="700" MaxHeight="640" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource ScryePanel}" BorderBrush="{DynamicResource ScryeLine}"
                    BorderThickness="1" CornerRadius="8" Padding="18">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding Settings.Title}" FontWeight="SemiBold" FontSize="16"
                               Foreground="{DynamicResource ScryeAccent}" Margin="0,0,0,8" />

                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8"
                                HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="Cancel" Command="{Binding CancelSettingsCommand}" />
                        <Button Content="Save" Command="{Binding SaveSettingsCommand}" />
                    </StackPanel>

                    <TabControl>
                        <!-- APPEARANCE -->
                        <TabItem Header="Appearance">
                            <StackPanel Spacing="6" Margin="0,8,0,0">
                                <TextBlock Text="Theme" />
                                <ComboBox ItemsSource="{Binding Settings.Themes}" SelectedItem="{Binding Settings.Theme}"
                                          HorizontalAlignment="Left" MinWidth="220" />
                                <TextBlock Text="MUD colors (ANSI palette)" Margin="0,6,0,0" />
                                <ComboBox ItemsSource="{Binding Settings.PaletteChoices}" SelectedItem="{Binding Settings.AnsiPalette}"
                                          HorizontalAlignment="Left" MinWidth="220" />
                                <TextBlock Text="How the MUD's color codes are painted. 'MUSHclient (classic)' matches MUSHclient's palette (pure-primary bold colors, olive yellow); 'Modern' uses the softer xterm palette. Applies to new output."
                                           Foreground="{DynamicResource ScryeTextDim}" FontSize="11" TextWrapping="Wrap" />
                                <TextBlock Text="Output font (monospaced fonts on this PC)" Margin="0,6,0,0" />
                                <ComboBox ItemsSource="{Binding Settings.FontChoices}" SelectedItem="{Binding Settings.SelectedFont}"
                                          HorizontalAlignment="Left" MinWidth="260" />
                                <Border Background="{DynamicResource ScryeOutputBg}" BorderBrush="{DynamicResource ScryeLine}" BorderThickness="1"
                                        CornerRadius="3" Padding="8,6" Margin="0,4,0,0">
                                    <StackPanel Spacing="1">
                                        <!-- The preview mimics the terminal, so it uses the MUD's own default colours rather than the app palette: #C0C0C0 is exactly Rgb.DefaultFore. Deliberately not themed. -->
                                        <TextBlock Text="The quick brown fox jumps over the lazy dog" Foreground="#C0C0C0"
                                                   FontFamily="{Binding Settings.PreviewFontFamily}"
                                                   FontSize="{Binding Settings.FontSize, FallbackValue=14}" />
                                        <TextBlock Text="Timber     22  413 avail  |  46  295 wants" Foreground="#C0C0C0"
                                                   FontFamily="{Binding Settings.PreviewFontFamily}"
                                                   FontSize="{Binding Settings.FontSize, FallbackValue=14}" />
                                        <TextBlock Text="ilW1 O0 () {} []  #~*-=+  MMMMiiii" Foreground="#7E8894"
                                                   FontFamily="{Binding Settings.PreviewFontFamily}"
                                                   FontSize="{Binding Settings.FontSize, FallbackValue=14}" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="Output font size" Margin="0,6,0,0" />
                                <TextBox Text="{Binding Settings.FontSize}" PlaceholderText="14" HorizontalAlignment="Left" Width="120" />
                                <Expander Header="Advanced: custom font / fallback list" Margin="0,6,0,0">
                                    <StackPanel Spacing="4" Margin="0,4,0,0">
                                        <TextBlock Text="Comma-separated families; the first one installed is used. Overrides the dropdown above. Use a monospaced font to keep columns aligned."
                                                   Foreground="{DynamicResource ScryeTextDim}" FontSize="11" TextWrapping="Wrap" />
                                        <TextBox Text="{Binding Settings.FontFamily}" PlaceholderText="Cascadia Mono, Consolas, monospace" />
                                    </StackPanel>
                                </Expander>
                                <TextBlock Text="Font applies to connected worlds. The theme applies on Save. Game output panes stay dark in every theme so ANSI colors from the MUD remain readable."
                                           Foreground="{DynamicResource ScryeTextDim}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                        </TabItem>

                        <!-- GLOBAL TRIGGERS -->
                        <TabItem Header="Triggers">
                            <Grid ColumnDefinitions="220,*" Margin="0,8,0,0">
                                <DockPanel Grid.Column="0" Margin="0,0,10,0">
                                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                                        <Button Content="Add" Command="{Binding Settings.AddTriggerCommand}" />
                                        <Button Content="Remove" Command="{Binding Settings.RemoveTriggerCommand}" />
                                    </StackPanel>
                                    <ListBox ItemsSource="{Binding Settings.Triggers}" SelectedItem="{Binding Settings.SelectedTrigger}"
                                             Height="420" Background="{DynamicResource ScryeInsetBg}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:TriggerRowViewModel">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource ScryeText}" />
                                                    <TextBlock Text="{Binding Pattern}" FontSize="10" Foreground="{DynamicResource ScryeTextDim}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                                <Border Grid.Column="1" DataContext="{Binding Settings.SelectedTrigger}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel Spacing="4" x:DataType="vm:TriggerRowViewModel" IsVisible="{Binding Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                                            <TextBlock Text="Name" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                            <TextBox Text="{Binding Name}" />
                                            <TextBlock Text="Pattern (line to match)" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                            <TextBox Text="{Binding Pattern}" />
                                            <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,2">
                                                <CheckBox Content="Regex" IsChecked="{Binding IsRegex}" />
                                                <CheckBox Content="Ignore case" IsChecked="{Binding IgnoreCase}" />
                                                <CheckBox Content="Enabled" IsChecked="{Binding Enabled}" />
                                            </StackPanel>
                                            <TextBlock Text="Send to" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                            <ComboBox ItemsSource="{x:Static vm:RuleRowViewModel.SendToValues}" SelectedItem="{Binding SendTo}"
                                                      HorizontalAlignment="Left" Width="180" />
                                            <TextBlock Text="Send (text / %1 %&lt;name&gt; ${var} template — one command per line)" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                            <TextBox Text="{Binding Send}" AcceptsReturn="True" TextWrapping="NoWrap"
                                                     MinHeight="52" MaxHeight="100" VerticalContentAlignment="Top" />
                                            <Grid ColumnDefinitions="*,*" Margin="0,2,0,0">
                                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                    <TextBlock Text="Variable (for Variable)" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                                    <TextBox Text="{Binding Variable}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                    <TextBlock Text="Script fn (for Script)" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                                    <TextBox Text="{Binding Script}" />
                                                </StackPanel>
                                            </Grid>
                                            <Grid ColumnDefinitions="*,*" Margin="0,2,0,0">
                                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                    <TextBlock Text="Group" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                                    <TextBox Text="{Binding Group}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                    <TextBlock Text="Sequence (lower first)" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                                    <TextBox Text="{Binding SequenceText}" />
                                                </StackPanel>
                                            </Grid>
                                            <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                    <TextBlock Text="Capture to pane (routes matched line; empty = none)" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                                    <TextBox Text="{Binding CapturePane}" PlaceholderText="e.g. Chats" />
                                                </StackPanel>
                                                <CheckBox Grid.Column="1" Content="Gag from main output" IsChecked="{Binding Gag}"
                                                          VerticalAlignment="Bottom" Margin="6,0,0,4" />
                                            </Grid>
                                            <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                    <TextBlock Text="Sound on match (beep, path, or sounds-folder file)" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                                    <TextBox Text="{Binding Sound}" PlaceholderText="e.g. beep or alert.wav" />
                                                </StackPanel>
                                                <CheckBox Grid.Column="1" Content="Notify (toast, flash, phone)" IsChecked="{Binding Notify}"
                                                          VerticalAlignment="Bottom" Margin="6,0,0,4" />
                                            </Grid>
                                            <Grid ColumnDefinitions="*,*,Auto" Margin="0,2,0,0">
                                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                    <TextBlock Text="Highlight colour (#RRGGBB; empty = off)" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                                    <!-- The hex below is example text shown to the user, not a UI colour: it tells them what format this field expects. Deliberately not themed. -->
                                                    <TextBox Text="{Binding HighlightColor}" PlaceholderText="#FFD040" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                                    <TextBlock Text="Highlight background (optional)" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                                    <TextBox Text="{Binding HighlightBack}" PlaceholderText="#400000" />
                                                </StackPanel>
                                                <CheckBox Grid.Column="2" Content="Whole line" IsChecked="{Binding HighlightWholeLine}"
                                                          VerticalAlignment="Bottom" Margin="6,0,0,4"
                                                          ToolTip.Tip="On: recolour the whole line. Off: only the matched text." />
                                            </Grid>
                                            <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,2">
                                                <CheckBox Content="Keep evaluating" IsChecked="{Binding KeepEvaluating}" />
                                                <CheckBox Content="One-shot" IsChecked="{Binding OneShot}" />
                                            </StackPanel>
                                            <Border Background="{DynamicResource ScryeInsetBg}" BorderBrush="{DynamicResource ScryeLine}"
                                                    BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,6,0,0">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="Test pattern" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                                    <DockPanel>
                                                        <Button DockPanel.Dock="Right" Content="Test" Command="{Binding TestCommand}" Margin="4,0,0,0" />
                                                        <TextBox Text="{Binding TestInput}" PlaceholderText="sample line to match…" />
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding TestResult}" Foreground="{DynamicResource ScryeText}" FontSize="11" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </TabItem>

                        <!-- GLOBAL ALIASES -->
                        <TabItem Header="Aliases">
                            <Grid ColumnDefinitions="220,*" Margin="0,8,0,0">
                                <DockPanel Grid.Column="0" Margin="0,0,10,0">
                                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                                        <Button Content="Add" Command="{Binding Settings.AddAliasCommand}" />
                                        <Button Content="Remove" Command="{Binding Settings.RemoveAliasCommand}" />
                                    </StackPanel>
                                    <ListBox ItemsSource="{Binding Settings.Aliases}" SelectedItem="{Binding Settings.SelectedAlias}"
                                             Height="420" Background="{DynamicResource ScryeInsetBg}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:AliasRowViewModel">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource ScryeText}" />
                                                    <TextBlock Text="{Binding Pattern}" FontSize="10" Foreground="{DynamicResource ScryeTextDim}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                                <Border Grid.Column="1" DataContext="{Binding Settings.SelectedAlias}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel Spacing="4" x:DataType="vm:AliasRowViewModel" IsVisible="{Binding Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                                            <TextBlock Text="Name" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                            <TextBox Text="{Binding Name}" />
                                            <TextBlock Text="Pattern (typed command to match)" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                            <TextBox Text="{Binding Pattern}" />
                                            <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,2">
                                                <CheckBox Content="Regex" IsChecked="{Binding IsRegex}" />
                                                <CheckBox Content="Ignore case" IsChecked="{Binding IgnoreCase}" />
                                                <CheckBox Content="Enabled" IsChecked="{Binding Enabled}" />
                                            </StackPanel>
                                            <TextBlock Text="Send to" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                            <ComboBox ItemsSource="{x:Static vm:RuleRowViewModel.SendToValues}" SelectedItem="{Binding SendTo}"
                                                      HorizontalAlignment="Left" Width="180" />
                                            <TextBlock Text="Send (text / %1 %&lt;name&gt; ${var} template — one command per line)" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                            <TextBox Text="{Binding Send}" AcceptsReturn="True" TextWrapping="NoWrap"
                                                     MinHeight="52" MaxHeight="100" VerticalContentAlignment="Top" />
                                            <Grid ColumnDefinitions="*,*" Margin="0,2,0,0">
                                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                    <TextBlock Text="Variable (for Variable)" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                                    <TextBox Text="{Binding Variable}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                    <TextBlock Text="Script fn (for Script)" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                                    <TextBox Text="{Binding Script}" />
                                                </StackPanel>
                                            </Grid>
                                            <Grid ColumnDefinitions="*,*" Margin="0,2,0,0">
                                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                    <TextBlock Text="Group" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                                    <TextBox Text="{Binding Group}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                    <TextBlock Text="Sequence (lower first)" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                                    <TextBox Text="{Binding SequenceText}" />
                                                </StackPanel>
                                            </Grid>
                                            <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,2">
                                                <CheckBox Content="Keep evaluating" IsChecked="{Binding KeepEvaluating}" />
                                                <CheckBox Content="One-shot" IsChecked="{Binding OneShot}" />
                                            </StackPanel>
                                            <Border Background="{DynamicResource ScryeInsetBg}" BorderBrush="{DynamicResource ScryeLine}"
                                                    BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,6,0,0">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="Test pattern" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                                    <DockPanel>
                                                        <Button DockPanel.Dock="Right" Content="Test" Command="{Binding TestCommand}" Margin="4,0,0,0" />
                                                        <TextBox Text="{Binding TestInput}" PlaceholderText="sample line to match…" />
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding TestResult}" Foreground="{DynamicResource ScryeText}" FontSize="11" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </TabItem>

                        <!-- GLOBAL TIMERS -->
                        <TabItem Header="Timers">
                            <Grid ColumnDefinitions="220,*" Margin="0,8,0,0">
                                <DockPanel Grid.Column="0" Margin="0,0,10,0">
                                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                                        <Button Content="Add" Command="{Binding Settings.AddTimerCommand}" />
                                        <Button Content="Remove" Command="{Binding Settings.RemoveTimerCommand}" />
                                    </StackPanel>
                                    <ListBox ItemsSource="{Binding Settings.Timers}" SelectedItem="{Binding Settings.SelectedTimer}"
                                             Height="420" Background="{DynamicResource ScryeInsetBg}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:TimerRowViewModel">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource ScryeText}" />
                                                    <TextBlock Text="{Binding IntervalText}" FontSize="10" Foreground="{DynamicResource ScryeTextDim}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                                <Border Grid.Column="1" DataContext="{Binding Settings.SelectedTimer}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel Spacing="4" x:DataType="vm:TimerRowViewModel" IsVisible="{Binding Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                                            <TextBlock Text="Name" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                            <TextBox Text="{Binding Name}" />
                                            <TextBlock Text="Interval (seconds)" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                            <TextBox Text="{Binding IntervalText}" HorizontalAlignment="Left" Width="120" />
                                            <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,2">
                                                <CheckBox Content="Enabled" IsChecked="{Binding Enabled}" />
                                                <CheckBox Content="One-shot" IsChecked="{Binding OneShot}" />
                                            </StackPanel>
                                            <TextBlock Text="Send to" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                            <ComboBox ItemsSource="{x:Static vm:TimerRowViewModel.SendToValues}" SelectedItem="{Binding SendTo}"
                                                      HorizontalAlignment="Left" Width="180" />
                                            <TextBlock Text="Send (text / template — one command per line)" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                            <TextBox Text="{Binding Send}" AcceptsReturn="True" TextWrapping="NoWrap"
                                                     MinHeight="52" MaxHeight="100" VerticalContentAlignment="Top" />
                                            <Grid ColumnDefinitions="*,*" Margin="0,2,0,0">
                                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                    <TextBlock Text="Variable (for Variable)" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                                    <TextBox Text="{Binding Variable}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                    <TextBlock Text="Script fn (for Script)" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                                    <TextBox Text="{Binding Script}" />
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="Group" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                            <TextBox Text="{Binding Group}" />
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </TabItem>

                        <!-- GLOBAL SEQUENCES -->
                        <TabItem Header="Sequences">
                            <Grid ColumnDefinitions="220,*" Margin="0,8,0,0">
                                <DockPanel Grid.Column="0" Margin="0,0,10,0">
                                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                                        <Button Content="Add" Command="{Binding Settings.AddSequenceCommand}" />
                                        <Button Content="Remove" Command="{Binding Settings.RemoveSequenceCommand}" />
                                    </StackPanel>
                                    <ListBox ItemsSource="{Binding Settings.Sequences}" SelectedItem="{Binding Settings.SelectedSequence}"
                                             Height="420" Background="{DynamicResource ScryeInsetBg}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:SequenceRowViewModel">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource ScryeText}" />
                                                    <TextBlock Text="{Binding Source}" FontSize="10" Foreground="{DynamicResource ScryeTextDim}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                                <Border Grid.Column="1" DataContext="{Binding Settings.SelectedSequence}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel Spacing="4" x:DataType="vm:SequenceRowViewModel" IsVisible="{Binding Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                                            <TextBlock Text="Name — run in-game with  .seq &lt;name&gt;" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                            <TextBox Text="{Binding Name}" />
                                            <TextBlock Text="Steps" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                            <TextBox Text="{Binding Source}" AcceptsReturn="True" TextWrapping="Wrap" Height="130"
                                                     FontFamily="Cascadia Mono, Consolas, monospace" />
                                            <CheckBox Content="Wait for the room prompt between steps" IsChecked="{Binding PromptGated}" Margin="0,2" />
                                            <Grid ColumnDefinitions="*,*" Margin="0,2,0,0">
                                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                    <TextBlock Text="Prompt timeout (s)" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                                    <TextBox Text="{Binding TimeoutText}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                    <TextBlock Text="Step delay when ungated (s)" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                                    <TextBox Text="{Binding DelayText}" />
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="Separate steps with ; or new lines. Repeat with  x3  or  *3. Delay with  wait 2 / pause 1.5."
                                                       Foreground="{DynamicResource ScryeTextDim}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </TabItem>

                        <!-- GLOBAL VARIABLES -->
                        <TabItem Header="Variables">
                            <DockPanel Margin="0,8,0,0">
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                                    <Button Content="Add" Command="{Binding Settings.AddVariableCommand}" />
                                    <Button Content="Remove" Command="{Binding Settings.RemoveVariableCommand}" />
                                </StackPanel>
                                <ListBox ItemsSource="{Binding Settings.Variables}" SelectedItem="{Binding Settings.SelectedVariable}"
                                         Height="440" Background="{DynamicResource ScryeInsetBg}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:VariableRowViewModel">
                                            <Grid ColumnDefinitions="*,*" Margin="0,1">
                                                <TextBox Grid.Column="0" Text="{Binding Key}" PlaceholderText="name" Margin="0,0,4,0" />
                                                <TextBox Grid.Column="1" Text="{Binding Value}" PlaceholderText="value" Margin="4,0,0,0" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </TabItem>

                        <!-- MACROS (keyboard shortcuts → command) -->
                        <TabItem Header="Macros">
                            <DockPanel Margin="0,8,0,0">
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                    <TextBlock Text="Bind a key to a command. Key examples: F1, Ctrl+K, Shift+F2, NumPad1. Send box: one command per line; ${var} expands."
                                               Foreground="{DynamicResource ScryeTextDim}" FontSize="11" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                                    <Button Content="Add" Command="{Binding Settings.AddMacroCommand}" />
                                    <Button Content="Remove" Command="{Binding Settings.RemoveMacroCommand}" />
                                </StackPanel>
                                <ListBox ItemsSource="{Binding Settings.Macros}" SelectedItem="{Binding Settings.SelectedMacro}"
                                         Height="420" Background="{DynamicResource ScryeInsetBg}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:MacroRowViewModel">
                                            <Grid ColumnDefinitions="120,*,Auto" Margin="0,1">
                                                <TextBox Grid.Column="0" Text="{Binding Key}" PlaceholderText="F1" Margin="0,0,4,0" />
                                                <TextBox Grid.Column="1" Text="{Binding Send}" PlaceholderText="command to send"
                                                         AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="30" MaxHeight="80"
                                                         VerticalContentAlignment="Top" Margin="4,0,4,0" />
                                                <CheckBox Grid.Column="2" Content="On" IsChecked="{Binding Enabled}"
                                                          VerticalAlignment="Center" Margin="4,0,0,0" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </Border>
        </Border>

        <!-- toast stack: trigger notifications + connection changes (click to dismiss) -->
        <ItemsControl ItemsSource="{Binding Toasts}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                      Margin="0,0,18,54" IsHitTestVisible="True">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ToastViewModel">
                    <Border Background="{DynamicResource ScryePanelAlt}" BorderBrush="{DynamicResource ScryeAccent}"
                            BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,6,0,0"
                            MaxWidth="380" Cursor="Hand" PointerPressed="OnToastPressed">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{DynamicResource ScryeAccent}" />
                            <TextBlock Text="{Binding Body}" TextWrapping="Wrap" FontSize="12"
                                       Foreground="{DynamicResource ScryeText}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
