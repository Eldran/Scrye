                                </DockPanel>
                                <Border Grid.Column="1" DataContext="{Binding Editor.SelectedAlias}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel Spacing="4" x:DataType="vm:AliasRowViewModel" IsVisible="{Binding Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                                            <TextBlock Text="Name" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                            <TextBox Text="{Binding Name}" />
                                            <TextBlock Text="Pattern (typed command to match)" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                            <TextBox Text="{Binding Pattern}" />
                                            <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,2">
                                                <CheckBox Content="Regex" IsChecked="{Binding IsRegex}" />
                                                <CheckBox Content="Ignore case" IsChecked="{Binding IgnoreCase}" />
                                                <CheckBox Content="Enabled" IsChecked="{Binding Enabled}" />
                                            </StackPanel>
                                            <TextBlock Text="Send to" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                            <ComboBox ItemsSource="{x:Static vm:RuleRowViewModel.SendToValues}" SelectedItem="{Binding SendTo}"
                                                      HorizontalAlignment="Left" Width="180" />
                                            <TextBlock Text="Send (text / %1 %&lt;name&gt; ${var} template)" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                            <TextBox Text="{Binding Send}" />
                                            <Grid ColumnDefinitions="*,*" Margin="0,2,0,0">
                                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                    <TextBlock Text="Variable (for Variable)" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                                    <TextBox Text="{Binding Variable}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                    <TextBlock Text="Script fn (for Script)" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                                    <TextBox Text="{Binding Script}" />
                                                </StackPanel>
                                            </Grid>
                                            <Grid ColumnDefinitions="*,*" Margin="0,2,0,0">
                                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                    <TextBlock Text="Group" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                                    <TextBox Text="{Binding Group}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                    <TextBlock Text="Sequence (lower first)" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                                    <TextBox Text="{Binding SequenceText}" />
                                                </StackPanel>
                                            </Grid>
                                            <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,2">
                                                <CheckBox Content="Keep evaluating" IsChecked="{Binding KeepEvaluating}" />
                                                <CheckBox Content="One-shot" IsChecked="{Binding OneShot}" />
                                            </StackPanel>
                                            <Border Background="{DynamicResource ScryeOutputBg}" BorderBrush="{DynamicResource ScryeLine}"
                                                    BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,6,0,0">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="Test pattern" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                                    <DockPanel>
                                                        <Button DockPanel.Dock="Right" Content="Test" Command="{Binding TestCommand}" Margin="4,0,0,0" />
                                                        <TextBox Text="{Binding TestInput}" Watermark="sample line to match…" />
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding TestResult}" Foreground="{DynamicResource ScryeText}" FontSize="11" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </TabItem>

                        <!-- TIMERS -->
                        <TabItem Header="Timers">
                            <Grid ColumnDefinitions="220,*" Margin="0,8,0,0">
                                <DockPanel Grid.Column="0" Margin="0,0,10,0">
                                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                                        <Button Content="Add" Command="{Binding Editor.AddTimerCommand}" />
                                        <Button Content="Remove" Command="{Binding Editor.RemoveTimerCommand}" />
                                    </StackPanel>
                                    <ListBox ItemsSource="{Binding Editor.Timers}" SelectedItem="{Binding Editor.SelectedTimer}"
                                             Height="420" Background="{DynamicResource ScryeOutputBg}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:TimerRowViewModel">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource ScryeText}" />
                                                    <TextBlock Text="{Binding IntervalText}" FontSize="10" Foreground="{DynamicResource ScryeTextDim}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                                <Border Grid.Column="1" DataContext="{Binding Editor.SelectedTimer}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel Spacing="4" x:DataType="vm:TimerRowViewModel" IsVisible="{Binding Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                                            <TextBlock Text="Name" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                            <TextBox Text="{Binding Name}" />
                                            <TextBlock Text="Interval (seconds)" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                            <TextBox Text="{Binding IntervalText}" HorizontalAlignment="Left" Width="120" />
                                            <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,2">
                                                <CheckBox Content="Enabled" IsChecked="{Binding Enabled}" />
                                                <CheckBox Content="One-shot" IsChecked="{Binding OneShot}" />
                                            </StackPanel>
                                            <TextBlock Text="Send to" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                            <ComboBox ItemsSource="{x:Static vm:TimerRowViewModel.SendToValues}" SelectedItem="{Binding SendTo}"
                                                      HorizontalAlignment="Left" Width="180" />
                                            <TextBlock Text="Send (text / template)" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                            <TextBox Text="{Binding Send}" />
                                            <Grid ColumnDefinitions="*,*" Margin="0,2,0,0">
                                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                    <TextBlock Text="Variable (for Variable)" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                                    <TextBox Text="{Binding Variable}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                    <TextBlock Text="Script fn (for Script)" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                                    <TextBox Text="{Binding Script}" />
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="Group" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                            <TextBox Text="{Binding Group}" />
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </TabItem>

                        <!-- SEQUENCES -->
                        <TabItem Header="Sequences">
                            <Grid ColumnDefinitions="220,*" Margin="0,8,0,0">
                                <DockPanel Grid.Column="0" Margin="0,0,10,0">
                                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                                        <Button Content="Add" Command="{Binding Editor.AddSequenceCommand}" />
                                        <Button Content="Remove" Command="{Binding Editor.RemoveSequenceCommand}" />
                                    </StackPanel>
                                    <ListBox ItemsSource="{Binding Editor.Sequences}" SelectedItem="{Binding Editor.SelectedSequence}"
                                             Height="420" Background="{DynamicResource ScryeOutputBg}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:SequenceRowViewModel">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource ScryeText}" />
                                                    <TextBlock Text="{Binding Source}" FontSize="10" Foreground="{DynamicResource ScryeTextDim}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                                <Border Grid.Column="1" DataContext="{Binding Editor.SelectedSequence}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel Spacing="4" x:DataType="vm:SequenceRowViewModel" IsVisible="{Binding Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                                            <TextBlock Text="Name — run in-game with  .seq &lt;name&gt;" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                            <TextBox Text="{Binding Name}" />
                                            <TextBlock Text="Steps" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                            <TextBox Text="{Binding Source}" AcceptsReturn="True" TextWrapping="Wrap" Height="130"
                                                     FontFamily="Cascadia Mono, Consolas, monospace" />
                                            <CheckBox Content="Wait for the room prompt between steps" IsChecked="{Binding PromptGated}" Margin="0,2" />
                                            <Grid ColumnDefinitions="*,*" Margin="0,2,0,0">
                                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                    <TextBlock Text="Prompt timeout (s)" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                                    <TextBox Text="{Binding TimeoutText}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                    <TextBlock Text="Step delay when ungated (s)" Foreground="{DynamicResource ScryeTextDim}" FontSize="11" />
                                                    <TextBox Text="{Binding DelayText}" />
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="Separate steps with ; or new lines. Repeat with  x3  or  *3. Delay with  wait 2 / pause 1.5."
                                                       Foreground="{DynamicResource ScryeTextDim}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </Border>
        </Border>

        <!-- global settings overlay -->
        <Border IsVisible="{Binding Settings, Converter={x:Static conv:ObjectConverters.IsNotNull}}"
                Background="#B0000000">
            <Border Width="700" MaxHeight="640" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource ScryePanel}" BorderBrush="{DynamicResource ScryeLine}"
                    BorderThickness="1" CornerRadius="8" Padding="18">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding Settings.Title}" FontWeight="SemiBold" FontSize="16"
                               Foreground="{DynamicResource ScryeAccent}" Margin="0,0,0,8" />

                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8"
                                HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="Cancel" Command="{Binding CancelSettingsCommand}" />
                        <Button Content="Save" Command="{Binding SaveSettingsCommand}" />
                    </StackPanel>

                    <TabControl>
                        <!-- APPEARANCE -->
                        <TabItem Header="Appearance">
                            <StackPanel Spacing="6" Margin="0,8,0,0">
                                <TextBlock Text="Output font family (comma-separated fallbacks)" />
                                <TextBox Text="{Binding Settings.FontFamily}" Watermark="Cascadia Mono, Consolas, monospace" />
                                <TextBlock Text="Output font size" />
                                <TextBox Text="{Binding Settings.FontSize}" Watermark="14" HorizontalAlignment="Left" Width="120" />
                                <TextBlock Text="Applies to connected worlds. Chrome font and the slate+cyan theme are fixed."
                                           Foreground="{DynamicResource ScryeTextDim}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                        </TabItem>

                        <!-- GLOBAL TRIGGERS -->
                        <TabItem Header="Triggers">
                            <Grid ColumnDefinitions="220,*" Margin="0,8,0,0">
                                <DockPanel Grid.Column="0" Margin="0,0,10,0">
                                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                                        <Button Content="Add" Command="{Binding Settings.AddTriggerCommand}" />
                                        <Button Content="Remove" Command="{Binding Settings.RemoveTriggerCommand}" />
                                    </StackPanel>
