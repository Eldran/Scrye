{
  "id": "3s-chat",
  "name": "3S Chat",
  "version": "1.0.0",
  "author": "Joakim",
  "description": "Captures all chat channels and tells into a Chats capture pane, with name watching (notify + beep).",
  "mudIds": [
    "*"
  ],
  "entry": "main.lua",
  "lang": "lua",
  "requires": {
    "scryeApi": ">=1.10 <2.0"
  },
  "permissions": [
    "output.read",
    "state.write",
    "capture.write",
    "notifications.show",
    "sound.play",
    "log.write",
    "storage.private",
    "timers.manage",
    "aliases.manage"
  ],
  "panes": [
    "Chats"
  ],
  "enabled": true
}
