<?xml version="1.0" encoding="utf-8"?>
<!--
  Self-contained Linux x64 build (no .NET install needed on the target machine).
  Publish from the CLI:  dotnet publish src/Scrye.App/Scrye.App.csproj -p:PublishProfile=linux-x64
  The publish-win.ps1 script at the repo root wraps this and packs the result as a
  .tar.gz — a zip would work, but tar is what a Linux user expects to receive.

  Cross-publishing from Windows is fine: the SDK downloads the linux-x64 runtime pack
  and produces an ELF apphost. Two Windows-looking properties in Scrye.App.csproj are
  simply ignored for a non-Windows RID — <OutputType>WinExe</OutputType>, which only
  sets the Windows PE subsystem so no console window appears, and <ApplicationManifest>,
  which is a Win32 resource. The Windows-only System.Speech reference contributes no
  assets here; the TTS code behind it is guarded by OperatingSystem.IsWindows().

  Same trimming note as win-x64: OFF on purpose. Avalonia resolves types by reflection
  and aggressive trimming breaks it.

  What the target machine still needs (present on any Ubuntu/Fedora desktop install,
  and the reason a headless container needs them added): libx11-6, libice6, libsm6,
  libfontconfig1 — plus at least one monospaced font, because Scrye's font picker
  enumerates the monospaced fonts it can find and looks broken without any.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <!-- ReadyToRun would need the crossgen host for the target platform; not worth the
         extra restore for a build that is smoke-tested rather than shipped daily. -->
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <PublishDir>bin\publish\linux-x64\</PublishDir>
  </PropertyGroup>
</Project>
