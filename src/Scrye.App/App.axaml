<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Scrye.App.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <!-- Cyan accent drives the whole Fluent theme: selection, toggles, checkboxes,
             progress bars, focus rings, the selected-tab underline. -->
        <Color x:Key="SystemAccentColor">#35C4D6</Color>
        <Color x:Key="SystemAccentColorDark1">#2BA9BA</Color>
        <Color x:Key="SystemAccentColorDark2">#238C9B</Color>
        <Color x:Key="SystemAccentColorDark3">#1B6F7C</Color>
        <Color x:Key="SystemAccentColorLight1">#54D0E0</Color>
        <Color x:Key="SystemAccentColorLight2">#79DBE8</Color>
        <Color x:Key="SystemAccentColorLight3">#9FE6F0</Color>

        <!-- Scrye "slate" palette — referenced by Theme.axaml and MainWindow.axaml.
             These are the startup defaults; ThemeService.Apply swaps them (and the
             accent family above) at runtime when a color scheme is selected. -->
        <SolidColorBrush x:Key="ScryeBg" Color="#14181F" />
        <SolidColorBrush x:Key="ScryeOutputBg" Color="#080A0C" />
        <SolidColorBrush x:Key="ScryeOutputText" Color="#D6DEE8" />
        <SolidColorBrush x:Key="ScryeInsetBg" Color="#10141A" />
        <SolidColorBrush x:Key="ScryePanel" Color="#1B212B" />
        <SolidColorBrush x:Key="ScryePanelAlt" Color="#222A36" />
        <SolidColorBrush x:Key="ScryePanelGlass" Color="#E61B212B" />
        <SolidColorBrush x:Key="ScryeLine" Color="#2C3542" />
        <SolidColorBrush x:Key="ScryeText" Color="#D6DEE8" />
        <SolidColorBrush x:Key="ScryeTextDim" Color="#8A97A8" />
        <SolidColorBrush x:Key="ScryeAccent" Color="#35C4D6" />
        <!-- Semantic status colours. Also the desktop resolution of the plugin API's
             ThemeToken.Success/Warning/Error/Info names. -->
        <SolidColorBrush x:Key="ScryeSuccess" Color="#4CBB6C" />
        <SolidColorBrush x:Key="ScryeWarning" Color="#E0A830" />
        <SolidColorBrush x:Key="ScryeError" Color="#E05050" />
        <SolidColorBrush x:Key="ScryeInfo" Color="#5AA8E0" />

        <!-- Chrome colours that used to be written inline in MainWindow.axaml. Named so a
             theme can reach them, and so the next person can tell "deliberately fixed" from
             "someone forgot". ScryeBadgeBg follows the scheme accent (ThemeService.Apply
             recomputes it); the other two are intentionally constant in every scheme. -->
        <SolidColorBrush x:Key="ScryeBadgeBg" Color="#D035C4D6" />
        <!-- Modal scrim: dims whatever is behind an overlay. Black in every scheme, including
             Light, because its job is to darken the background, not to match the palette. -->
        <SolidColorBrush x:Key="ScryeScrim" Color="#B0000000" />
        <!-- Text drawn on top of a filled gauge/progress bar. The fill is a saturated accent
             in every scheme, so this stays white rather than following the body text colour
             (which would vanish on the bar in the Light scheme). -->
        <SolidColorBrush x:Key="ScryeOnBar" Color="#FFFFFF" />
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Scrye.App/Styles/Theme.axaml" />
    </Application.Styles>
</Application>
