<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Scrye theme: slate surfaces + proportional chrome font. The cyan accent comes
         from SystemAccentColor (App.axaml); this file handles neutrals, typography,
         and consistent rounding/spacing on the stock Fluent controls. -->

    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource ScryeBg}" />
        <Setter Property="Foreground" Value="{DynamicResource ScryeText}" />
        <Setter Property="FontFamily" Value="Segoe UI, sans-serif" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style Selector="Button">
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="12,5" />
    </Style>

    <Style Selector="ToggleButton">
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="10,5" />
    </Style>

    <Style Selector="TextBox">
        <Setter Property="CornerRadius" Value="5" />
    </Style>

    <Style Selector="ComboBox">
        <Setter Property="CornerRadius" Value="5" />
    </Style>

    <Style Selector="TabItem">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="MinHeight" Value="0" />
    </Style>

    <Style Selector="ListBoxItem">
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="MinHeight" Value="0" />
    </Style>
</Styles>
