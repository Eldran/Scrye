<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Scrye theme: slate surfaces + proportional chrome font. The cyan accent comes
         from SystemAccentColor (App.axaml); this file handles neutrals, typography,
         and consistent rounding/spacing on the stock Fluent controls. -->

    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource ScryeBg}" />
        <Setter Property="Foreground" Value="{DynamicResource ScryeText}" />
        <Setter Property="FontFamily" Value="Segoe UI, sans-serif" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style Selector="Button">
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="12,5" />
    </Style>

    <Style Selector="ToggleButton">
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="10,5" />
    </Style>

    <Style Selector="TextBox">
        <Setter Property="CornerRadius" Value="5" />
    </Style>

    <!-- Command input line: pinned to the fixed terminal colours so the interactive
         output area reads the same in every colour scheme (an exception to theming).
         The bar itself follows the theme; only this input keeps the terminal look. -->
    <Style Selector="TextBox.terminalinput">
        <Setter Property="Background" Value="{DynamicResource ScryeOutputBg}" />
        <Setter Property="Foreground" Value="{DynamicResource ScryeOutputText}" />
        <Setter Property="CaretBrush" Value="{DynamicResource ScryeOutputText}" />
    </Style>
    <!-- Hold the background through pointer-over / focus (Fluent otherwise swaps it for a
         themed brush on those states). PART_BorderElement is the Fluent TextBox surface. -->
    <Style Selector="TextBox.terminalinput /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource ScryeOutputBg}" />
    </Style>
    <Style Selector="TextBox.terminalinput:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource ScryeOutputBg}" />
    </Style>
    <Style Selector="TextBox.terminalinput:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource ScryeOutputBg}" />
    </Style>

    <Style Selector="ComboBox">
        <Setter Property="CornerRadius" Value="5" />
    </Style>

    <Style Selector="TabItem">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="MinHeight" Value="0" />
    </Style>

    <Style Selector="ListBoxItem">
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="MinHeight" Value="0" />
    </Style>
</Styles>
