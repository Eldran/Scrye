<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The in-process companion server: Kestrel + a WebSocket endpoint, hosted INSIDE
    Scrye.App so it sits next to the WorldViewModel/MainWindowViewModel state it taps,
    with no IPC (design doc §9).

    Kestrel and System.Net.WebSockets come from the shared framework via FrameworkReference,
    so — like Scrye.Core and Scrye.Companion.Protocol — this project takes no NuGet
    dependencies. It also does not reference Scrye.App: everything it needs from the app
    arrives through ICompanionSessionSource (Sessions/ICompanionSessionSource.cs), which
    keeps the server testable against a fake and keeps the dependency arrow pointing one way.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Scrye.Core\Scrye.Core.csproj" />
    <ProjectReference Include="..\Scrye.Companion.Protocol\Scrye.Companion.Protocol.csproj" />
  </ItemGroup>

  <!--
    The PWA assets (manifest, service worker, icons) are internal because nothing outside
    this assembly should be routing to them — but they are exactly the sort of thing that
    fails silently: a manifest naming an icon that 404s, or a PNG that is not the size it
    claims, costs installability on Android with no error surfacing anywhere. Opening them
    to the test assembly is cheaper than making them public or standing up Kestrel.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="Scrye.Core.Tests" />
  </ItemGroup>
</Project>
